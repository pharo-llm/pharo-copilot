{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> liveContextSnapshotFor: aContext [

	| pair source position prefix suffix |
	pair := self liveSourceAndPositionFor: aContext.
	pair ifNil: [ ^ self contextSnapshotFor: aContext ].

	source := pair first.
	position := pair second.
	prefix := position > 0
		ifTrue: [ source copyFrom: 1 to: position ]
		ifFalse: [ '' ].
	suffix := position < source size
		ifTrue: [ source copyFrom: position + 1 to: source size ]
		ifFalse: [ '' ].

	^ Dictionary new
		at: #prefix put: prefix;
		at: #suffix put: suffix;
		at: #position put: position;
		at: #sourceLength put: source size;
		yourself
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> liveEditorFor: aContext [

	| engine editor |
	aContext ifNil: [ ^ nil ].

	engine := self engineFor: aContext.
	editor := engine
		ifNotNil: [ [ engine editor ] on: Error do: [ nil ] ]
		ifNil: [ nil ].
	editor ifNotNil: [ ^ editor ].

	^ (aContext respondsTo: #editor)
		ifTrue: [ [ aContext editor ] on: Error do: [ nil ] ]
		ifFalse: [ nil ]
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> liveSourceAndPositionFor: aContext [

	| editor source caret position |
	editor := self liveEditorFor: aContext.
	editor ifNil: [ ^ nil ].
	((editor respondsTo: #text) and: [ editor respondsTo: #caret ]) ifFalse: [ ^ nil ].

	source := [ editor text ifNil: [ nil ] ] on: Error do: [ nil ].
	source ifNil: [ ^ nil ].
	source := source asString.

	caret := [ editor caret ] on: Error do: [ nil ].
	caret ifNil: [ ^ nil ].
	position := (caret - 1 max: 0) min: source size.

	^ { source. position }
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> isLanguageSpec: aString [ 
	"Only treat known fence tags as language specs.
	Do NOT treat arbitrary one-line code as a language marker."

	| candidate trimmed |
	aString ifNil: [ ^ false ].

	candidate := aString asString.
	candidate isEmpty ifTrue: [ ^ false ].

	trimmed := candidate trimBoth.
	(trimmed size = candidate size) ifFalse: [ ^ false ].

	candidate := trimmed asLowercase.

	^ #(
		'smalltalk' 'pharo' 'st'
		'bash' 'sh' 'shell'
		'python'
		'javascript' 'js'
		'typescript' 'ts'
		'json'
		'java'
		'c' 'cpp'
		'xml' 'html'
		'ruby' 'php'
		'sql'
		'yaml' 'yml'
		'go'
		'rust'
	) includes: candidate

]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> isLikelyContextEcho: suggestionString forPrefix: prefixString typedFragment: typedFragment [ 

	| suggestion prefix fragment trimmed first |
	suggestion := (suggestionString ifNil: [ '' ]) asString trimBoth.
	prefix := (prefixString ifNil: [ '' ]) asString.
	fragment := (typedFragment ifNil: [ '' ]) asString.

	suggestion isEmpty ifTrue: [ ^ true ].

	"Reject chunks that already exist in the prefix/context"
	((suggestion size > 8) and: [ prefix includesSubstring: suggestion ]) ifTrue: [
		^ true ].

	"When user is in the middle of typing a token, completion must look like a tail"
	fragment isEmpty ifTrue: [ ^ false ].

	trimmed := suggestion trimLeft.
	trimmed isEmpty ifTrue: [ ^ true ].

	first := trimmed first.

	^ (self isWordChar: first) not
		and: [ (':_' includes: first) not ]
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> averageLogprobFromMetadata: metadata [

	| numbers total |
	numbers := self logprobNumbersFromMetadata: metadata.
	numbers isEmpty ifTrue: [ ^ nil ].

	total := 0.
	numbers do: [ :each | total := total + each ].
	^ total / numbers size
]

