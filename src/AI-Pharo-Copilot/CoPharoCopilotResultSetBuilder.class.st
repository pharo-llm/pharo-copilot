"
Builds completion result sets using suggestions generated by the Ollama API.

"
Class {
	#name : 'CoPharoCopilotResultSetBuilder',
	#superclass : 'CoResultSetBuilder',
	#instVars : [
		'debounceProcess',
		'debounceToken',
		'debounceMilliseconds',
		'idleMilliseconds',
		'classContextCache',
		'menuMorph',
		'completionCache',
		'cachedClient',
		'lastSnapshotKey',
		'lastSnapshotValue'
	],
	#category : 'AI-Pharo-Copilot',
	#package : 'AI-Pharo-Copilot'
}

{ #category : 'instance creation' }
CoPharoCopilotResultSetBuilder class >> initializeOnContext: aSystemCompletionContext [

	"Create and initialize a builder bound to the given completion context."
	^ self new
		initializeOnContext: aSystemCompletionContext;
		yourself
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> applyContent: contentString toContext: aContext expectedPrefix: expectedPrefix suffix: expectedSuffix contextInfo: contextInfo [ 

	self
		applyContents: { contentString }
		toContext: aContext
		expectedPrefix: expectedPrefix
		suffix: expectedSuffix
		contextInfo: contextInfo
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> applyContents: contentCollection toContext: aContext expectedPrefix: expectedPrefix suffix: expectedSuffix contextInfo: contextInfo [

	| entries position |

	(self hasStaleContextFor: aContext expectedPrefix: expectedPrefix suffix: expectedSuffix)
		ifTrue: [ ^ self logStaleContextForExpectedPrefix: expectedPrefix suffix: expectedSuffix context: aContext ].

	entries := self
		completionEntriesFrom: contentCollection
		inContext: aContext
		contextInfo: contextInfo.
	entries isEmpty ifTrue: [ ^ self logNoEntriesAfterCleaningFor: contentCollection ].

	position := self menuPositionForContextOrDefault: aContext.

	self openCompletionMenuFor: aContext entries: entries position: position
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> behaviorFor: aContext [

	^ (aContext respondsTo: #completionClass)
		ifTrue: [ aContext completionClass ]
		ifFalse: [
			(aContext respondsTo: #behavior)
				ifTrue: [ aContext behavior ]
				ifFalse: [ nil ] ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> buildClassContextFor: methodClass selector: selector prefix: prefixString [

	| builder context classDefinition instanceSide classSide |

	builder := selector ifNotNil: [ CoPCContextFactory forSelector: selector ].
	builder ifNotNil: [
		^ builder buildForFIMWithPrefix: prefixString
	].

	classDefinition := self safeDefinitionStringFor: methodClass.
	instanceSide := self
		methodSourcesFor: methodClass
		around: selector
		limit: CopilotSettings maxInstanceMethods.
	classSide := self
		methodSourcesFor: (methodClass ifNotNil: [ methodClass class ])
		around: nil
		limit: CopilotSettings maxClassMethods.

	context := self
		classDefinition: classDefinition
		instanceMethods: instanceSide
		classMethods: classSide.

	^ context
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> buildCompletion [
    | context snapshot prefix suffix contextInfo delay sessionId classContext cached |

    context := completionContext.

    (self shouldRequestCompletionForContext: context) ifFalse: [
        ^ self emptyResultSet ].

    snapshot := self contextSnapshotFor: context.
    prefix := snapshot at: #prefix.
    suffix := snapshot at: #suffix.
    contextInfo := self contextInfoFor: context prefix: prefix suffix: suffix.

    sessionId := CoPharoCopilotLogger completionSessionId.
    contextInfo
        at: #sessionId put: sessionId;
        at: #timestamp put: DateAndTime now asString;
        at: #rejected put: OrderedCollection new;
        at: #returned put: OrderedCollection new.

    "Synchronous cache lookup — zero model call on hit."
    classContext := self classContextFor: context prefix: prefix.
    cached := self
        cachedSuggestionsForPrefix: prefix
        suffix: suffix
        classContext: classContext
        contextInfo: contextInfo.
    cached ifNotNil: [
        | entries position |
        entries := self completionEntriesFrom: cached inContext: context contextInfo: contextInfo.
        entries isEmpty ifFalse: [
            position := self menuPositionForContextOrDefault: context.
            self logCompletionSessionSummaryFor: cached cacheHit: true contextInfo: contextInfo.
            self openCompletionMenuFor: context entries: entries position: position.
            ^ self emptyResultSet ] ].

    delay := self requestDelayForSnapshot: snapshot.

    self
        scheduleCompletionFor: context
        prefix: prefix
        suffix: suffix
        contextInfo: contextInfo
        delayMilliseconds: delay.

    ^ self emptyResultSet
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> cacheClassContext: contextString for: methodClass [

	methodClass ifNil: [ ^ self ].
	self ensureClassContextCacheCapacity.

	classContextCache at: methodClass put: (
		Dictionary new
			at: #stamp put: (self classStampFor: methodClass);
			at: #context put: contextString;
			at: #accessTime put: DateAndTime now;
			yourself
	)
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> cacheSuggestions: suggestions prefix: prefixString suffix: suffixString classContext: classContext [

	suggestions isEmpty ifTrue: [ ^ self ].

	self completionCache
		at: prefixString
		suffix: suffixString
		context: classContext
		put: suggestions asArray
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> cachedClassContextFor: methodClass [

	| cached stamp |
	classContextCache ifNil: [ classContextCache := Dictionary new ].

	stamp := self classStampFor: methodClass.
	cached := classContextCache at: methodClass ifAbsent: [ nil ].

	(cached notNil and: [ (cached at: #stamp ifAbsent: [ #(0 0) ]) = stamp ]) ifFalse: [
		^ nil
	].

	cached at: #accessTime put: DateAndTime now.
	^ cached at: #context ifAbsent: [ '' ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> cachedSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext contextInfo: contextInfo [

	| cachedContent |
	cachedContent := self exactCachedSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext.

	cachedContent ifNil: [
		cachedContent := self nearMatchCachedSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext
	].

	contextInfo at: #cacheHit put: cachedContent notNil.
	^ cachedContent
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> classContextFor: aContext [

	| snapshot prefix |
	aContext ifNil: [ ^ '' ].
	snapshot := self contextSnapshotFor: aContext.
	prefix := snapshot at: #prefix ifAbsent: [ '' ].
	^ self classContextFor: aContext prefix: prefix
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> classContextFor: aContext prefix: prefixString [

	| behavior selector methodClass cachedContext builtContext |
	behavior := self behaviorFor: aContext.
	behavior ifNil: [ ^ '' ].

	selector := self selectorFromPrefix: prefixString.
	methodClass := self methodClassForBehavior: behavior selector: selector.

	cachedContext := self cachedClassContextFor: methodClass.
	cachedContext ifNotNil: [ ^ cachedContext ].

	builtContext := self buildClassContextFor: methodClass selector: selector prefix: prefixString.
	self cacheClassContext: builtContext for: methodClass.

	^ builtContext
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> classDefinition: classDefinitionString instanceMethods: instanceMethodsString classMethods: classMethodsString [
	"Format the class context (definition and methods) into a single string suitable for passing to the model."

	| hasDefinition hasInstance hasClass |
	hasDefinition := classDefinitionString isEmpty not.
	hasInstance := instanceMethodsString isEmpty not.
	hasClass := classMethodsString isEmpty not.

	(hasDefinition or: [ hasInstance or: hasClass ]) ifFalse: [ ^ '' ].

	^ String streamContents: [ :stream |
		hasDefinition ifTrue: [
			stream
				nextPutAll: 'Class Definition:';
				cr;
				nextPutAll: classDefinitionString;
				cr;
				cr ].

		hasInstance ifTrue: [
			stream
				nextPutAll: 'Instance Side Methods:';
				cr;
				nextPutAll: instanceMethodsString;
				cr ].

		hasClass ifTrue: [
			stream
				nextPutAll: 'Class Side Methods:';
				cr;
				nextPutAll: classMethodsString ] ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> classStampFor: aBehavior [

	"Cheap stamp: changes when methodDict is replaced or selector count changes."
	aBehavior ifNil: [ ^ #(0 0) ].
	^ { aBehavior methodDict identityHash. aBehavior selectors size }
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> cleanedContentFrom: aString [
	"Normalize suggestion text: prefer code-fence body if present, drop language markers, trim surrounding whitespace."

	| text fenceStart rest fenceEnd body newlineIndex firstLine delimiterIndex |
	text := (aString ifNil: [ '' ]) asString.
	text isEmpty ifTrue: [ ^ '' ].

	fenceStart := text indexOfSubCollection: '```' startingAt: 1 ifAbsent: [ 0 ].
	fenceStart > 0 ifTrue: [
		rest := (fenceStart + 3 <= text size)
			ifTrue: [ text copyFrom: fenceStart + 3 to: text size ]
			ifFalse: [ '' ].

		fenceEnd := self indexOfClosingFenceIn: rest startingAt: 1.
		fenceEnd := fenceEnd = 0
			ifTrue: [ rest size + 1 ]
			ifFalse: [ fenceEnd ].

		body := fenceEnd <= 1
			ifTrue: [ '' ]
			ifFalse: [ rest copyFrom: 1 to: fenceEnd - 1 ].

		"Drop a first-line language spec like ```smalltalk"
		newlineIndex := body indexOf: Character lf ifAbsent: [ 0 ].
		newlineIndex > 0 ifTrue: [
			firstLine := body copyFrom: 1 to: newlineIndex - 1.
			((firstLine isEmpty) or: [ self isLanguageSpec: firstLine ]) ifTrue: [
				body := newlineIndex < body size
					ifTrue: [ body copyFrom: newlineIndex + 1 to: body size ]
					ifFalse: [ '' ] ] ]
		ifFalse: [
			(self isLanguageSpec: body) ifTrue: [ body := '' ] ].

		^ body trimBoth
	].

	"Fallback: keep only the first paragraph if multiple paragraphs exist."
	delimiterIndex := text indexOfSubCollection: (String lf , String lf) startingAt: 1 ifAbsent: [ 0 ].
	body := delimiterIndex = 0
		ifTrue: [ text ]
		ifFalse: [ text copyFrom: 1 to: delimiterIndex - 1 ].

	^ body trimBoth
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> closeMenu [
	"Close the menu if it's open."

	menuMorph ifNotNil: [
		menuMorph isClosed ifFalse: [ menuMorph delete ].
		menuMorph := nil
	]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> collectNormalizedSuggestionsFor: client prefix: prefixString suffix: suffixString context: classContext contextInfo: contextInfo [

	| desiredCount collected seen |
	desiredCount := CopilotSettings completionSuggestionsCount.
	collected := OrderedCollection new.
	seen := Set new.

	1 to: desiredCount do: [ :attempt |
		| content |
		collected size >= desiredCount ifTrue: [ ^ self finalizeCollectedSuggestions: collected contextInfo: contextInfo ].

		content := self
			normalizedSuggestionFrom: client
			prefix: prefixString
			suffix: suffixString
			context: classContext
			attempt: attempt
			contextInfo: contextInfo.

		(content isEmpty not and: [ (seen includes: content) not ]) ifTrue: [
			seen add: content.
			collected add: content
		]
	].

	^ self finalizeCollectedSuggestions: collected contextInfo: contextInfo
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> completionCache [
	"Return the completion cache, creating it lazily."

	^ completionCache ifNil: [ completionCache := CoPharoCopilotCompletionCache new ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> completionCache: aCache [

	completionCache := aCache
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> completionEntriesFrom: contentCollection inContext: aContext [
	| cleaned fakeContextInfo |

	cleaned := (contentCollection collect: [ :each | self cleanedContentFrom: each ])
		select: [ :each | each isEmpty not ].

	fakeContextInfo := Dictionary new
		at: #prefix put: '';
		yourself.

	^ cleaned collect: [ :each |
		| entry |
		entry := CoCopilotEntry
			contents: each
			description: (self descriptionForSuggestion: each inContext: aContext).
		entry label: (self menuLabelForSuggestion: each contextInfo: fakeContextInfo).
		entry
	]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> completionEntriesFrom: contentCollection inContext: aContext contextInfo: contextInfo [
	| cleaned sessionId |

	cleaned := (contentCollection collect: [ :each | self cleanedContentFrom: each ])
		select: [ :each | each isEmpty not ].

	sessionId := contextInfo at: #sessionId ifAbsent: [ nil ].

	^ cleaned collect: [ :each |
		| entry |
		entry := CoCopilotEntry
			contents: each
			description: (self descriptionForSuggestion: each inContext: aContext).

		entry label: (self menuLabelForSuggestion: each contextInfo: contextInfo).

		(entry respondsTo: #sessionId:) ifTrue: [
			entry sessionId: sessionId ].

		entry
	]
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> contextInfoFor: aContext prefix: prefixString suffix: suffixString [
	"Build a diagnostic payload used for logging and debugging completion requests."

	^ Dictionary new
		at: #contextClass put: aContext class name;
		at: #cursorPosition put: aContext position;
		at: #sourceSize put: aContext source size;
		at: #fullSource put: aContext source;
		at: #prefix put: prefixString;
		at: #suffix put: suffixString;
		yourself
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> contextSnapshotFor: aContext [
    | source position prefix suffix |
    source := [ aContext source ifNil: [ '' ] ] on: Error do: [ '' ].
    position := [ aContext position ifNil: [ 0 ] ] on: Error do: [ 0 ].
    position := (position max: 0) min: source size.

    prefix := position > 0
        ifTrue: [ source copyFrom: 1 to: position ]
        ifFalse: [ '' ].
    suffix := position < source size
        ifTrue: [ source copyFrom: position + 1 to: source size ]
        ifFalse: [ '' ].

    (lastSnapshotKey notNil
        and: [ lastSnapshotKey first = source identityHash
        and: [ lastSnapshotKey second = position ] ])
            ifTrue: [ ^ lastSnapshotValue ].

    lastSnapshotKey := { source identityHash. position }.
    lastSnapshotValue := Dictionary new
        at: #prefix put: prefix;
        at: #suffix put: suffix;
        at: #position put: position;
        at: #sourceLength put: source size;
        yourself.

    ^ lastSnapshotValue
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> debounceMilliseconds [
	"Return the current debounce delay used before firing a completion request."

	^ debounceMilliseconds ifNil: [ CopilotSettings completionDebounceMilliseconds ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> debounceMilliseconds: anInteger [
	"Set the debounce delay (milliseconds) used before firing a completion request."

	debounceMilliseconds := self normalizedDelayMilliseconds: anInteger default: CopilotSettings completionDebounceMilliseconds
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> deferUI: aBlock [
	"Run UI work on Morphic's deferred UI queue when possible."

	| worldStateClass uiClass ui |
	worldStateClass := Smalltalk globals at: #WorldState ifAbsent: [ nil ].
	(worldStateClass notNil and: [ worldStateClass respondsTo: #addDeferredUIMessage: ]) ifTrue: [
		^ worldStateClass addDeferredUIMessage: aBlock
	].

	uiClass := Smalltalk globals at: #UIManager ifAbsent: [ nil ].
	(uiClass notNil and: [ uiClass respondsTo: #default ]) ifTrue: [
		ui := uiClass default.
		(ui respondsTo: #defer:) ifTrue: [ ^ ui defer: aBlock ]
	].

	^ aBlock value
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> descriptionForSuggestion: suggestionString inContext: aContext [

	| firstLine selector behavior classComment |
	firstLine := suggestionString lines
		ifEmpty: [ '' ]
		ifNotEmpty: [ :lines | lines first ].

	selector := [ (OCParser parseFaultyMethod: suggestionString) selector ]
		on: Error
		do: [ nil ].

	behavior := (aContext respondsTo: #completionClass)
		ifTrue: [ aContext completionClass ]
		ifFalse: [
			(aContext respondsTo: #behavior)
				ifTrue: [ aContext behavior ]
				ifFalse: [ nil ] ].

	classComment := behavior
		ifNotNil: [
			[ behavior comment asString ]
				on: Error
				do: [ '' ] ]
		ifNil: [ '' ].

	selector ifNotNil: [
		^ String streamContents: [ :stream |
			stream
				nextPutAll: 'Suggested selector: ';
				nextPutAll: selector asString;
				cr; cr.
			firstLine isEmpty ifFalse: [
				stream
					nextPutAll: 'Preview: ';
					nextPutAll: firstLine;
					cr; cr ].
			classComment isEmpty ifFalse: [
				stream
					nextPutAll: 'Class comment:';
					cr;
					nextPutAll: classComment ] ] ].

	^ String streamContents: [ :stream |
		stream
			nextPutAll: 'Preview: ';
			nextPutAll: firstLine.
		classComment isEmpty ifFalse: [
			stream
				cr; cr;
				nextPutAll: 'Class comment:';
				cr;
				nextPutAll: classComment ] ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> emptyResultSet [

	^ CoResultSet fetcher: (CoCollectionFetcher onCollection: #())
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> ensureClassContextCacheCapacity [

	| maxClassContextCacheSize |
	maxClassContextCacheSize := 256.
	classContextCache ifNil: [ ^ self ].
	classContextCache size < maxClassContextCacheSize ifTrue: [ ^ self ].
	[ classContextCache size >= maxClassContextCacheSize ] whileTrue: [
			| oldestKey oldestTime |
			oldestKey := nil.
			oldestTime := nil.
			classContextCache keysAndValuesDo: [ :k :v |
					| accessTime |
					accessTime := v at: #accessTime ifAbsent: [ DateAndTime epoch ].
					(oldestTime isNil or: [ accessTime < oldestTime ]) ifTrue: [
							oldestKey := k.
							oldestTime := accessTime ] ].
			oldestKey ifNil: [ ^ self ].
			classContextCache removeKey: oldestKey ifAbsent: [ ] ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> exactCachedSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext [

	^ self completionCache
		at: prefixString
		suffix: suffixString
		context: classContext
		ifPresent: [ :cached |
			cached isArray
				ifTrue: [ cached ]
				ifFalse: [ { cached } ] ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> extractResponseContentFromRaw: rawResponseString [
	"Convert the response to a string. The response is already normalized by OllamaClient"

	^ rawResponseString asString
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> fallbackMenuPositionFor: aContext [

	| engine editor textArea position |
	engine := [ aContext engine ] on: Error do: [ nil ].
	editor := engine
		ifNotNil: [ [ engine editor ] on: Error do: [ nil ] ]
		ifNil: [ nil ].
	editor ifNil: [ ^ nil ].

	textArea := [ editor textArea ]
		on: Error
		do: [ [ editor morph ] on: Error do: [ nil ] ].
	textArea ifNil: [ ^ nil ].

	position := [ editor caret ]
		on: Error
		do: [ [ aContext position ] on: Error do: [ nil ] ].
	position ifNil: [ ^ nil ].

	[
		| paragraph charBlock |
		paragraph := textArea paragraph.
		paragraph ifNotNil: [
			charBlock := paragraph characterBlockForIndex: position.
			charBlock ifNotNil: [
				^ textArea localPointToGlobal: charBlock bottomLeft ] ] ]
		on: Error
		do: [ ].

	[
		| cursor cursorBounds |
		cursor := textArea cursor.
		cursor ifNotNil: [
			cursorBounds := cursor bounds.
			cursorBounds ifNotNil: [
				^ textArea localPointToGlobal: cursorBounds bottomLeft ] ] ]
		on: Error
		do: [ ].

	^ [ textArea boundsInWorld bottomLeft ] on: Error do: [ nil ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> fetchSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext contextInfo: contextInfo [

	^ self
		collectNormalizedSuggestionsFor: self ollamaClient
		prefix: prefixString
		suffix: suffixString
		context: classContext
		contextInfo: contextInfo
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> filteredNearMatchSuggestions: cachedSuggestions forPrefix: prefixString [

	| lastChar filtered |
	prefixString isEmpty ifTrue: [ ^ nil ].

	lastChar := prefixString last asString.

	(cachedSuggestions isArray and: [ cachedSuggestions anySatisfy: [ :s | s beginsWith: lastChar ] ]) ifFalse: [
		^ nil
	].

	filtered := cachedSuggestions
		select: [ :s | s beginsWith: lastChar ]
		thenCollect: [ :s | s allButFirst: lastChar size ].

	^ filtered ifEmpty: [ nil ] ifNotEmpty: [ filtered ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> finalizeCollectedSuggestions: collected contextInfo: contextInfo [

	contextInfo at: #rawSuggestions put: collected asArray.
	^ collected asArray
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> hasStaleContextFor: aContext expectedPrefix: expectedPrefix suffix: expectedSuffix [

	| snapshot currentPrefix currentSuffix |
	snapshot := self contextSnapshotFor: aContext.
	currentPrefix := snapshot at: #prefix.
	currentSuffix := snapshot at: #suffix.

	^ (currentPrefix = expectedPrefix and: [ currentSuffix = expectedSuffix ]) not
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> idleMilliseconds [
	"Idle delay used when user finishes a word and pauses."

	^ idleMilliseconds ifNil: [ CopilotSettings completionIdleMilliseconds]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> idleMilliseconds: anInteger [

	idleMilliseconds := self normalizedDelayMilliseconds: anInteger default: CopilotSettings completionIdleMilliseconds
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> indexOfClosingFenceIn: text startingAt: startIndex [
	"Return the index of the last valid closing ``` fence in text (must be on its own line-ish); 0 if none."

	| idx lastValid size |
	text isEmpty ifTrue: [ ^ 0 ].

	size := text size.
	lastValid := 0.
	idx := text indexOfSubCollection: '```' startingAt: startIndex ifAbsent: [ 0 ].

	[ idx > 0 ] whileTrue: [
		| before after |
		before := (idx = 1)
			or: [ | prev |
				prev := text at: idx - 1.
				(prev = Character lf) or: [ prev = Character cr ] ].

		after := (idx + 3 > size)
			or: [ | next |
				next := text at: idx + 3.
				(next = Character lf) or: [ next = Character cr ] ].

		(before and: after) ifTrue: [ lastValid := idx ].
		idx := text indexOfSubCollection: '```' startingAt: idx + 1 ifAbsent: [ 0 ].
	].

	^ lastValid
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> initialize [
	"Initialize default debounce settings."

	super initialize.
	debounceToken := 0
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> initializeOnContext: aSystemCompletionContext [
	"Bind this builder to a completion context provided by the completion system."

	completionContext := aSystemCompletionContext
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> insertAtCaretIfPossibleIn: aContext text: aString [
	"Try hard to INSERT (not replace) so user text is never deleted."

	| editor |

	(aString isNil or: [ aString isEmpty ]) ifTrue: [ ^ false ].
	(aContext respondsTo: #editor) ifFalse: [ ^ false ].

	editor := [ aContext editor ] on: Error do: [ nil ].
	editor ifNil: [ ^ false ].

	"Preferred: real insertion at caret"
	(editor respondsTo: #addString:) ifTrue: [
		editor addString: aString.
		^ true
	].

	"Fallback: replace empty selection only"
	(editor respondsTo: #selectionInterval)
		ifTrue: [
			editor selectionInterval isEmpty ifTrue: [
				editor replaceSelectionWith: aString.
				^ true
			]
		].

	^ false

]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> isLanguageSpec: aString [ 
	"Only treat known fence tags as language specs.
	Do NOT treat arbitrary one-line code as a language marker."

	| candidate trimmed |
	aString ifNil: [ ^ false ].

	candidate := aString asString.
	candidate isEmpty ifTrue: [ ^ false ].

	trimmed := candidate trimBoth.
	(trimmed size = candidate size) ifFalse: [ ^ false ].

	candidate := trimmed asLowercase.

	^ #(
		'smalltalk' 'pharo' 'st'
		'bash' 'sh' 'shell'
		'python'
		'javascript' 'js'
		'typescript' 'ts'
		'json'
		'java'
		'c' 'cpp'
		'xml' 'html'
		'ruby' 'php'
		'sql'
		'yaml' 'yml'
		'go'
		'rust'
	) includes: candidate

]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> isLikelyContextEcho: suggestionString forPrefix: prefixString typedFragment: typedFragment [ 

	| suggestion prefix fragment trimmed first |
	suggestion := (suggestionString ifNil: [ '' ]) asString trimBoth.
	prefix := (prefixString ifNil: [ '' ]) asString.
	fragment := (typedFragment ifNil: [ '' ]) asString.

	suggestion isEmpty ifTrue: [ ^ true ].

	"Reject chunks that already exist in the prefix/context"
	((suggestion size > 8) and: [ prefix includesSubstring: suggestion ]) ifTrue: [
		^ true ].

	"When user is in the middle of typing a token, completion must look like a tail"
	fragment isEmpty ifTrue: [ ^ false ].

	trimmed := suggestion trimLeft.
	trimmed isEmpty ifTrue: [ ^ true ].

	first := trimmed first.

	^ (self isWordChar: first) not
		and: [ (':_' includes: first) not ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> isTemplateLeakOrPromptEcho: cleanedString rawResponse: rawString prefix: prefixString [

	| cleaned raw prefix leakMarkers |
	cleaned := (cleanedString ifNil: [ '' ]) asString trimBoth.
	raw := (rawString ifNil: [ '' ]) asString.
	prefix := (prefixString ifNil: [ '' ]) asString trimBoth.

	leakMarkers := #(
		'{{'
		'}}'
		'{1}'
		'{2}'
		'{3}'
		'%1'
		'%2'
		'%3'
		'System Prompt:'
		'Class context provided by Pharo Copilot:'
	).

	cleaned isEmpty ifTrue: [ ^ true ].

	(leakMarkers anySatisfy: [ :each | raw includesSubstring: each ]) ifTrue: [ ^ true ].
	(leakMarkers anySatisfy: [ :each | cleaned includesSubstring: each ]) ifTrue: [ ^ true ].

	(prefix isEmpty not and: [
		cleaned = prefix
			or: [ cleaned beginsWith: prefix ] ])
		ifTrue: [ ^ true ].

	^ false
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> isTriggerBoundaryChar: ch [
	"Characters that indicate a boundary (space/newline/punct)."
	ch ifNil: [ ^ true ].
	(ch isSeparator) ifTrue: [ ^ true ].
	^ '.;:,()[]{}' includes: ch
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> isWordChar: ch [

	ch ifNil: [ ^ false ].
	^ ch isLetter
		or: [ ch isDigit
		or: [ ch = $_ ] ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> logCompletionResponseFor: rawResponse normalized: normalizedString attempt: attempt prefix: prefixString durationMs: durationMs contextInfo: contextInfo [
	"Log a single completion response returned by the model. Captures the raw and
	normalized text, its line/character counts, the first line, and the duration of
	the model call. Also appends the response to the per-session JSON file so each
	completion can be inspected after the fact."

	| rawString normString lines firstLine status sessionId modelName safePrefix previewLimit details returnedEntry |
	rawString := (rawResponse ifNil: [ '' ]) asString.
	normString := (normalizedString ifNil: [ '' ]) asString.
	lines := normString isEmpty
		ifTrue: [ rawString lines ]
		ifFalse: [ normString lines ].
	firstLine := lines isEmpty
		ifTrue: [ '' ]
		ifFalse: [ lines first ].
	status := normString isEmpty ifTrue: [ 'rejected' ] ifFalse: [ 'accepted' ].
	safePrefix := (prefixString ifNil: [ '' ]) asString.
	previewLimit := 2000.

	sessionId := contextInfo ifNotNil: [
		contextInfo at: #sessionId ifAbsent: [ nil ] ].
	modelName := [ CopilotSettings modelName ] on: Error do: [ :ex | nil ].

	details := Dictionary new
		at: #sessionId put: (sessionId ifNil: [ '' ]) asString;
		at: #model put: (modelName ifNil: [ '' ]) asString;
		at: #attempt put: attempt;
		at: #status put: status;
		at: #durationMs put: durationMs;
		at: #lineCount put: lines size;
		at: #charCount put: normString size;
		at: #rawCharCount put: rawString size;
		at: #firstLine put: ((firstLine size > 160)
			ifTrue: [ (firstLine first: 160), '...' ]
			ifFalse: [ firstLine ]);
		at: #rawResponse put: ((rawString size > previewLimit)
			ifTrue: [ (rawString first: previewLimit), '...' ]
			ifFalse: [ rawString ]);
		at: #normalized put: ((normString size > previewLimit)
			ifTrue: [ (normString first: previewLimit), '...' ]
			ifFalse: [ normString ]);
		at: #prefixTail put: ((safePrefix size > 80)
			ifTrue: [ safePrefix last: 80 ]
			ifFalse: [ safePrefix ]);
		yourself.

	CoPharoCopilotLogger
		logBackEndEvent: 'Completion returned'
		details: details.

	returnedEntry := Dictionary new
		at: #attempt put: attempt;
		at: #status put: status;
		at: #durationMs put: durationMs;
		at: #lineCount put: lines size;
		at: #charCount put: normString size;
		at: #rawCharCount put: rawString size;
		at: #firstLine put: firstLine;
		at: #rawResponse put: rawString;
		at: #normalized put: normString;
		at: #timestamp put: DateAndTime now asString;
		yourself.

	contextInfo ifNotNil: [
		(contextInfo at: #returned ifAbsentPut: [ OrderedCollection new ])
			add: returnedEntry ].

	sessionId ifNotNil: [
		CoPharoCopilotLogger
			updateCompletionSession: sessionId
			addReturned: returnedEntry ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> logCompletionSessionSummaryFor: suggestions cacheHit: cacheHit contextInfo: contextInfo [
	"Log a single summary entry per completion session capturing how many suggestions
	were emitted, whether they came from cache, and the line count of each suggestion."

	| sessionId details perSuggestion |
	sessionId := contextInfo ifNotNil: [
		contextInfo at: #sessionId ifAbsent: [ nil ] ].

	perSuggestion := (suggestions ifNil: [ #() ]) asArray withIndexCollect: [ :each :index |
		| content contentLines |
		content := each asString.
		contentLines := content lines.
		Dictionary new
			at: #index put: index;
			at: #lineCount put: contentLines size;
			at: #charCount put: content size;
			at: #firstLine put: (contentLines isEmpty
				ifTrue: [ '' ]
				ifFalse: [ contentLines first ]);
			yourself ].

	details := Dictionary new
		at: #sessionId put: (sessionId ifNil: [ '' ]) asString;
		at: #cacheHit put: cacheHit;
		at: #suggestionCount put: (suggestions ifNil: [ #() ]) size;
		at: #suggestions put: perSuggestion asArray;
		yourself.

	CoPharoCopilotLogger
		logBackEndEvent: 'Completion session summary'
		details: details
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> logNoEntriesAfterCleaningFor: contentCollection [

	CoPharoCopilotLogger logFrontEndEvent: 'Skipping completion menu: no entries after cleaning' details: (
		Dictionary new
			at: #rawSuggestionCount put: contentCollection size;
			yourself
	)
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> logRejectedSuggestionFrom: rawResponse attempt: attempt prefix: prefixString [

	CoPharoCopilotLogger logBackEndEvent: 'Suggestion rejected after normalization' details: (
		Dictionary new
			at: #attempt put: attempt;
			at: #rawResponse put: rawResponse asString;
			at: #prefixTail put: ((prefixString size > 80)
				ifTrue: [ prefixString last: 80 ]
				ifFalse: [ prefixString ]);
			yourself
	)
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> logRejectedSuggestionFrom: rawResponse attempt: attempt prefix: prefixString contextInfo: contextInfo [

	| rejected sessionId |
	CoPharoCopilotLogger logBackEndEvent: 'Suggestion rejected after normalization' details: (
		Dictionary new
			at: #attempt put: attempt;
			at: #rawResponse put: rawResponse asString;
			at: #prefixTail put: ((prefixString size > 80)
				ifTrue: [ prefixString last: 80 ]
				ifFalse: [ prefixString ]);
			yourself
	).

	rejected := contextInfo at: #rejected ifAbsentPut: [ OrderedCollection new ].
	rejected add: rawResponse asString.

	sessionId := contextInfo at: #sessionId ifAbsent: [ nil ].
	sessionId ifNotNil: [
		CoPharoCopilotLogger
			updateCompletionSession: sessionId
			addRejected: rawResponse asString ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> logStaleContextForExpectedPrefix: expectedPrefix suffix: expectedSuffix context: aContext [

	| snapshot currentPrefix currentSuffix |
	snapshot := self contextSnapshotFor: aContext.
	currentPrefix := snapshot at: #prefix ifAbsent: [ '' ].
	currentSuffix := snapshot at: #suffix ifAbsent: [ '' ].

	CoPharoCopilotLogger logFrontEndEvent: 'Skipping completion menu: stale context' details: (
		Dictionary new
			at: #expectedPrefixTail put: ((expectedPrefix ifNil: [ '' ]) size > 80
				ifTrue: [ (expectedPrefix ifNil: [ '' ]) last: 80 ]
				ifFalse: [ expectedPrefix ifNil: [ '' ] ]);
			at: #currentPrefixTail put: (currentPrefix size > 80
				ifTrue: [ currentPrefix last: 80 ]
				ifFalse: [ currentPrefix ]);
			at: #expectedSuffixHead put: ((expectedSuffix ifNil: [ '' ]) size > 80
				ifTrue: [ (expectedSuffix ifNil: [ '' ]) first: 80 ]
				ifFalse: [ expectedSuffix ifNil: [ '' ] ]);
			at: #currentSuffixHead put: (currentSuffix size > 80
				ifTrue: [ currentSuffix first: 80 ]
				ifFalse: [ currentSuffix ]);
			at: #position put: (snapshot at: #position ifAbsent: [ nil ]);
			at: #sourceLength put: (snapshot at: #sourceLength ifAbsent: [ nil ]);
			yourself
	).

	^ self
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> menuClosed [
	"Called when the menu is closed externally."

	menuMorph := nil
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> menuLabelForSuggestion: suggestionString contextInfo: contextInfo [
	| prefix visiblePrefix |

	prefix := (contextInfo at: #prefix ifAbsent: [ '' ]) asString.

	"Only show the current line before the caret"
	visiblePrefix := prefix lines
		ifEmpty: [ '' ]
		ifNotEmpty: [ :lines | lines last ].

	"Keep the menu stable and short"
	visiblePrefix size > 50 ifTrue: [
		visiblePrefix := '…', (visiblePrefix last: 50)
	].

	^ visiblePrefix , suggestionString 
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> menuPositionFor: aContext [

	| engine editor token |
	engine := [ aContext engine ] on: Error do: [ nil ].
	engine ifNil: [ ^ self fallbackMenuPositionFor: aContext ].

	editor := [ engine editor ] on: Error do: [ nil ].
	editor ifNil: [ ^ self fallbackMenuPositionFor: aContext ].

	token := [ engine completionToken ]
		on: Error
		do: [ [ aContext completionToken ] on: Error do: [ '' ] ].

	"Use the exact same anchor API as Complishon"
	^ [ editor selectionPosition: token ]
		on: Error
		do: [ self fallbackMenuPositionFor: aContext ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> menuPositionForContextOrDefault: aContext [

	| position |
	position := self menuPositionFor: aContext.

	position ifNil: [
		CoPharoCopilotLogger logFrontEndEvent: 'Completion menu position unavailable' details: (
			Dictionary new
				at: #contextClass put: aContext class name;
				at: #hasEditorAccessor put: (aContext respondsTo: #editor);
				yourself
		).
		^ 200 @ 200
	].

	^ position
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> methodClassForBehavior: behavior selector: selector [

	| compiledMethod |
	compiledMethod := selector
		ifNotNil: [ behavior compiledMethodAt: selector ifAbsent: [ nil ] ]
		ifNil: [ nil ].

	^ compiledMethod
		ifNotNil: [ compiledMethod methodClass ]
		ifNil: [ behavior ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> methodSourcesFor: aBehavior [
	"Collect and concatenate the source of all methods of the given behavior (sorted), ignoring failures."

	aBehavior ifNil: [ ^ '' ].

	^ String streamContents: [ :stream |
		[
			(aBehavior selectors asSortedCollection) do: [ :selector |
				| source |
				source := [ aBehavior sourceCodeAt: selector ] on: Error do: [ nil ].
				source ifNotNil: [
					stream
						nextPutAll: source;
						cr;
						cr ] ] ]
			on: Error
			do: [ ] ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> methodSourcesFor: aBehavior around: aSelector limit: limitInteger [ 

	"Only a window of methods; avoids huge prompt building."
	| sorted idx half start end |
	aBehavior ifNil: [ ^ '' ].

	sorted := aBehavior selectors asSortedCollection asArray.
	sorted isEmpty ifTrue: [ ^ '' ].

	idx := (aSelector isNil)
		ifTrue: [ 1 ]
		ifFalse: [ sorted indexOf: aSelector ifAbsent: [ 1 ] ].

	half := limitInteger // 2.
	start := (idx - half) max: 1.
	end := (start + limitInteger - 1) min: sorted size.
	start := (end - limitInteger + 1) max: 1.

	^ String streamContents: [ :stream |
		(start to: end) do: [ :i |
			| sel src |
			sel := sorted at: i.
			src := [ aBehavior sourceCodeAt: sel ] on: Error do: [ nil ].
			src ifNotNil: [
				stream nextPutAll: src; cr; cr ] ] ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> minimumPrefixLength [
	"Minimum prefix length required before we request a completion."

	^ CopilotSettings minimumPrefixLength
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> nearMatchCachedSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext [

	^ self completionCache
		nearMatchAt: prefixString
		suffix: suffixString
		context: classContext
		ifPresent: [ :cached | self filteredNearMatchSuggestions: cached forPrefix: prefixString ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> normalizeSuggestion: rawResponse forPrefix: prefixString [

	| raw text cleaned typedFragment |
	raw := self extractResponseContentFromRaw: rawResponse. 
	text := self removeEchoedPrefix: raw prefix: prefixString. 
	cleaned := self cleanedContentFrom: text. 
	typedFragment := self trailingWordFragmentIn: prefixString.
	cleaned := self stripTypedFragment: typedFragment fromSuggestion: cleaned. 
	(self isTemplateLeakOrPromptEcho: cleaned rawResponse: raw prefix: prefixString) ifTrue: [ ^ '' ].

	(self isLikelyContextEcho: cleaned forPrefix: prefixString typedFragment: typedFragment) ifTrue: [ ^ '' ].

	^ cleaned trimBoth
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> normalizedDelayMilliseconds: anObject default: defaultValue [
	"Normalize a delay, enforcing a non-zero millisecond range."

	| candidate |
	anObject ifNil: [ ^ defaultValue ].
	candidate := [ anObject asInteger ] on: Error do: [ defaultValue ].
	candidate <= 0 ifTrue: [ ^ defaultValue ].
	candidate := candidate max: 1.
	^ candidate min: 60000
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> normalizedSuggestionFrom: client prefix: prefixString suffix: suffixString context: classContext attempt: attempt [

	| rawResponse content |
	rawResponse := client generateForPrefix: prefixString suffix: suffixString context: classContext.
	content := self normalizeSuggestion: rawResponse forPrefix: prefixString.

	(content isEmpty and: [ rawResponse asString trimBoth isEmpty not ]) ifTrue: [
		self logRejectedSuggestionFrom: rawResponse attempt: attempt prefix: prefixString
	].

	^ content
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> normalizedSuggestionFrom: client prefix: prefixString suffix: suffixString context: classContext attempt: attempt contextInfo: contextInfo [

	| rawResponse content startMs durationMs |
	startMs := Time millisecondClockValue.
	rawResponse := client generateForPrefix: prefixString suffix: suffixString context: classContext.
	durationMs := [ Time millisecondClockValue - startMs ]
		on: Error
		do: [ :ex | 0 ].
	content := self normalizeSuggestion: rawResponse forPrefix: prefixString.

	self
		logCompletionResponseFor: rawResponse
		normalized: content
		attempt: attempt
		prefix: prefixString
		durationMs: durationMs
		contextInfo: contextInfo.

	(content isEmpty and: [ rawResponse asString trimBoth isEmpty not ]) ifTrue: [
		self
			logRejectedSuggestionFrom: rawResponse
			attempt: attempt
			prefix: prefixString
			contextInfo: contextInfo
	].

	^ content
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> ollamaClient [ 

	^ cachedClient ifNil: [ cachedClient := CoPCOllamaClient new ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> openCompletionMenuFor: aContext entries: entries position: position [

	self deferUI: [
		[
			self closeMenu.
			menuMorph := CopilotMenuMorph
				builder: self
				context: aContext
				entries: entries
				position: position.

			(menuMorph respondsTo: #takeKeyboardFocus) ifTrue: [
				menuMorph takeKeyboardFocus
			]
		]
			on: Error
			do: [ :ex |
				CoPharoCopilotLogger
					logError: 'Failed to open completion menu'
					origin: #CoPharoCopilotResultSetBuilder
					exception: ex
					payload: (
						Dictionary new
							at: #entryCount put: entries size;
							at: #position put: position printString;
							yourself
					) ]
	]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> positionFromSnapshot: snapshot [

	^ snapshot at: #position ifAbsent: [ 0 ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> processCompletionFor: aContext prefix: prefixString suffix: suffixString contextInfo: contextInfo [

	[
		| classContext suggestions sessionId sessionPayload cacheHit |

		classContext := self classContextFor: aContext prefix: prefixString.
		self updateContextInfo: contextInfo withClassContext: classContext.
		contextInfo at: #classContext put: classContext.

		suggestions := self cachedSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext contextInfo: contextInfo.
		cacheHit := suggestions notNil.
		suggestions ifNil: [
			suggestions := self fetchSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext contextInfo: contextInfo.
			self cacheSuggestions: suggestions prefix: prefixString suffix: suffixString classContext: classContext
		].

		sessionId := contextInfo at: #sessionId ifAbsent: [ nil ].
		sessionId ifNotNil: [
			sessionPayload := CoPharoCopilotLogger
				initialCompletionPayloadForContextInfo: contextInfo
				prefix: prefixString
				suffix: suffixString
				classContext: classContext
				cacheStats: self completionCache statisticsDictionary.
			CoPharoCopilotLogger
				writeCompletionSession: sessionPayload
				sessionId: sessionId ].

		self logCompletionSessionSummaryFor: suggestions cacheHit: cacheHit contextInfo: contextInfo.

		self
			applyContents: suggestions
			toContext: aContext
			expectedPrefix: prefixString
			suffix: suffixString
			contextInfo: contextInfo
	]
		on: Error
		do: [ :ex | self logAsynchronousCompletionError: ex contextInfo: contextInfo prefix: prefixString suffix: suffixString ]

]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> removeEchoedPrefix: contentString prefix: prefixString [
	"Strip the user prefix when the model echoes it back.
	Works for exact echo, leading whitespace, and fenced answers."

	| content prefix trimmedContent trimmedPrefix |
	content := (contentString ifNil: [ '' ]) asString.
	prefix := (prefixString ifNil: [ '' ]) asString.

	(content isEmpty or: [ prefix isEmpty ]) ifTrue: [ ^ content ].

	(content beginsWith: prefix) ifTrue: [
		^ content allButFirst: prefix size ].

	trimmedContent := content trimLeft.
	(trimmedContent beginsWith: prefix) ifTrue: [
		^ (trimmedContent allButFirst: prefix size) trimLeft ].

	trimmedPrefix := prefix trimRight.
	(trimmedPrefix isEmpty not and: [ trimmedContent beginsWith: trimmedPrefix ]) ifTrue: [
		^ (trimmedContent allButFirst: trimmedPrefix size) trimLeft ].

	((trimmedContent beginsWith: '```') and: [ trimmedContent includesSubstring: prefix ]) ifTrue: [
		| unfenced |
		unfenced := self cleanedContentFrom: trimmedContent.
		(unfenced beginsWith: prefix) ifTrue: [
			^ unfenced allButFirst: prefix size ] ].

	^ content
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> requestDelayForSnapshot: snapshot [

	| source position |
	source := self sourceFromSnapshot: snapshot.
	position := self positionFromSnapshot: snapshot.
	^ self requestDelayForSource: source position: position
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> requestDelayForSource: source position: pos [
	| before |
	before := pos > 0 ifTrue: [ source at: pos ] ifFalse: [ nil ].

	"Fast when user just hit a boundary (like space)."
	(self isTriggerBoundaryChar: before) ifTrue: [ ^ self debounceMilliseconds ].

	"Otherwise wait for real idle."
	^ self idleMilliseconds
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> safeDefinitionStringFor: aBehavior [
	"Return the class definition string for a behavior, or empty string if unavailable."

	aBehavior ifNil: [ ^ '' ].
	^ [ aBehavior definition asString ] on: Error do: [ '' ]
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> safeSourceAndPositionFor: aContext [
	| source pos |
	source := [ aContext source ifNil: [ '' ] ] on: Error do: [ '' ].
	pos := [ aContext position ifNil: [ 0 ] ] on: Error do: [ 0 ].
	pos := (pos max: 0) min: source size.
	^ { source. pos }
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> scheduleCompletionFor: aContext prefix: prefixString suffix: suffixString contextInfo: contextInfo [
	^ self
		scheduleCompletionFor: aContext
		prefix: prefixString
		suffix: suffixString
		contextInfo: contextInfo
		delayMilliseconds: self debounceMilliseconds
]

{ #category : 'API - building' }
CoPharoCopilotResultSetBuilder >> scheduleCompletionFor: aContext prefix: prefixString suffix: suffixString contextInfo: contextInfo delayMilliseconds: delayMs [
	"Debounce: cancel pending, schedule only latest."

	| token priority |
	debounceToken ifNil: [ debounceToken := 0 ].
	debounceToken := debounceToken + 1.
	token := debounceToken.

	debounceProcess ifNotNil: [ debounceProcess terminate ].

	priority := (Processor class includesSelector: #userSchedulingPriority)
		ifTrue: [ Processor userSchedulingPriority ]
		ifFalse: [ Processor userBackgroundPriority ].

	debounceProcess := [
		(Delay forMilliseconds: delayMs) wait.
		token = debounceToken ifTrue: [
			self
				processCompletionFor: aContext
				prefix: prefixString
				suffix: suffixString
				contextInfo: contextInfo ] ] forkAt: priority
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> selectorFromPrefix: prefixString [

	| extractor ast |
	extractor := CNSelectorExtractor new.
	ast := OCParser parseFaultyMethod: prefixString.
	^ extractor extractSelectorFromAST: ast atPosition: 1
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> shouldRequestCompletionForContext: aContext [
	"NO trigger while cursor is inside the same word."
	| pair source pos before after |
	aContext ifNil: [ ^ false ].

	pair := self safeSourceAndPositionFor: aContext.
	source := pair first.
	pos := pair second.

	(pos < self minimumPrefixLength) ifTrue: [ ^ false ].

	before := pos > 0 ifTrue: [ source at: pos ] ifFalse: [ nil ].
	after := pos < source size ifTrue: [ source at: pos + 1 ] ifFalse: [ nil ].

	"Cursor inside a word => do NOT initialize completion engine."
	((self isWordChar: before) and: [ self isWordChar: after ]) ifTrue: [ ^ false ].

	^ true
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> shouldRequestCompletionForPrefix: prefixString suffix: suffixString [
	"Decide whether it's worth requesting a completion for the current prefix/suffix."

	prefixString ifNil: [ ^ false ].
	(prefixString size < self minimumPrefixLength) ifTrue: [ ^ false ].
	^ true
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> sourceFromSnapshot: snapshot [

	| prefix suffix |
	prefix := snapshot at: #prefix ifAbsent: [ '' ].
	suffix := snapshot at: #suffix ifAbsent: [ '' ].
	^ prefix , suffix
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> stripTypedFragment: typedFragment fromSuggestion: suggestionString [

	| suggestion fragment trimmed |
	suggestion := (suggestionString ifNil: [ '' ]) asString.
	fragment := (typedFragment ifNil: [ '' ]) asString.

	fragment isEmpty ifTrue: [ ^ suggestion ].
	suggestion isEmpty ifTrue: [ ^ suggestion ].

	(suggestion beginsWith: fragment) ifTrue: [
		^ suggestion allButFirst: fragment size ].

	trimmed := suggestion trimLeft.
	(trimmed beginsWith: fragment) ifTrue: [
		^ (trimmed allButFirst: fragment size) trimLeft ].

	^ suggestion
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> trailingWordFragmentIn: aString [

	| text i |
	text := (aString ifNil: [ '' ]) asString.
	text isEmpty ifTrue: [ ^ '' ].

	i := text size.
	[ i > 0 and: [ self isWordChar: (text at: i) ] ] whileTrue: [
		i := i - 1 ].

	i = text size ifTrue: [ ^ '' ].
	^ text copyFrom: i + 1 to: text size
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> updateContextInfo: contextInfo withClassContext: classContext [

	contextInfo
		at: #classContextLength put: classContext size;
		at: #classContextPresent put: classContext isEmpty not
]
