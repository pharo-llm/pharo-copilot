CoPharoCopilotResultSetBuilder >> isLoggingEnabled [

	^ [ CopilotSettings loggingEnabled ] on: Error do: [ false ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> isTemplateLeakOrPromptEcho: cleanedString rawResponse: rawString prefix: prefixString [

	| cleaned raw prefix leakMarkers |
	cleaned := (cleanedString ifNil: [ '' ]) asString trimBoth.
	raw := (rawString ifNil: [ '' ]) asString.
	prefix := (prefixString ifNil: [ '' ]) asString trimBoth.

	leakMarkers := #(
		'{{'
		'}}'
		'{1}'
		'{2}'
		'{3}'
		'%1'
		'%2'
		'%3'
		'System Prompt:'
		'Class context provided by Pharo Copilot:'
	).

	cleaned isEmpty ifTrue: [ ^ true ].

	(leakMarkers anySatisfy: [ :each | raw includesSubstring: each ]) ifTrue: [ ^ true ].
	(leakMarkers anySatisfy: [ :each | cleaned includesSubstring: each ]) ifTrue: [ ^ true ].

	(prefix isEmpty not and: [
		cleaned = prefix
			or: [ cleaned beginsWith: prefix ] ])
		ifTrue: [ ^ true ].

	^ false
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> isBadCompletionShape: suggestionString [

	| suggestion lower firstLine badPrefixes |
	suggestion := (suggestionString ifNil: [ '' ]) asString trimBoth.
	suggestion isEmpty ifTrue: [ ^ true ].
	lower := suggestion asLowercase.

	((suggestion includesSubstring: '```') or: [
		(suggestion includesSubstring: '<|fim_') or: [
			(suggestion includesSubstring: '<|file_sep|') or: [
				suggestion includesSubstring: '<|repo_name|' ] ] ])
		ifTrue: [ ^ true ].

	((suggestion beginsWith: 'Class {') or: [
		suggestion beginsWith: 'Trait {'])
			ifTrue: [ ^ true ].

	firstLine := suggestion lines
		ifEmpty: [ suggestion ]
		ifNotEmpty: [ :lines | lines first trimBoth ].
	(firstLine includesSubstring: '>>') ifTrue: [ ^ true ].

	badPrefixes := #(
		'here is'
		'here''s'
		'sure'
		'the completion'
		'this completion'
		'i would'
		'you can'
	).

	^ badPrefixes anySatisfy: [ :each | lower beginsWith: each ]
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> isLowConfidenceMetadata: metadata [

	| average |
	average := self averageLogprobFromMetadata: metadata.
	average ifNil: [ ^ false ].
	^ average < self lowConfidenceAverageLogprobThreshold
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> isSuggestion: suggestionString acceptableForCompletionKind: completionKind [

	| suggestion kind |
	(self isBadCompletionShape: suggestionString) ifTrue: [ ^ false ].

	suggestion := suggestionString asString trimBoth.
	kind := completionKind ifNil: [ #expression ].

	kind = #messageTail ifTrue: [
		^ (suggestion includes: Character lf) not
			and: [ (suggestion includes: $.) not ] ].

	^ true
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> isInsideCommentOrStringIn: sourceString position: positionInteger [

	| source limit stringQuote commentQuote inString inComment index character |
	source := (sourceString ifNil: [ '' ]) asString.
	limit := ((positionInteger ifNil: [ 0 ]) max: 0) min: source size.
	stringQuote := Character value: 39.
	commentQuote := Character value: 34.
	inString := false.
	inComment := false.
	index := 1.

	[ index <= limit ] whileTrue: [
		character := source at: index.
		inComment
			ifTrue: [
				character = commentQuote ifTrue: [ inComment := false ].
				index := index + 1 ]
			ifFalse: [
				inString
					ifTrue: [
						character = stringQuote
							ifTrue: [
								(index < limit and: [ (source at: index + 1) = stringQuote ])
									ifTrue: [ index := index + 2 ]
									ifFalse: [
										inString := false.
										index := index + 1 ] ]
							ifFalse: [ index := index + 1 ] ]
					ifFalse: [
						character = commentQuote
							ifTrue: [ inComment := true ]
							ifFalse: [
								character = stringQuote ifTrue: [ inString := true ] ].
						index := index + 1 ] ] ].

	^ inString or: [ inComment ]
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> isTriggerBoundaryChar: ch [
	"Characters that indicate a boundary (space/newline/punct)."
	ch ifNil: [ ^ true ].
	(ch isSeparator) ifTrue: [ ^ true ].
	^ '.;:,()[]{}' includes: ch
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> isWordChar: ch [

	ch ifNil: [ ^ false ].
	^ ch isLetter
		or: [ ch isDigit
		or: [ ch = $_ ] ]
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> lastNonSeparatorCharacterIn: aString [

	| text index ch |
	text := (aString ifNil: [ '' ]) asString.
	index := text size.
	[ index > 0 ] whileTrue: [
		ch := text at: index.
		ch isSeparator ifFalse: [ ^ ch ].
		index := index - 1 ].
	^ nil
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> logprobNumbersFromMetadata: metadata [

	| response raw numbers |
	metadata ifNil: [ ^ #() ].
	response := metadata at: #response ifAbsent: [ ^ #() ].
	raw := response
		at: #logprobs
		ifAbsent: [ response at: 'logprobs' ifAbsent: [ ^ #() ] ].

	(raw respondsTo: #do:) ifFalse: [ ^ #() ].

	numbers := OrderedCollection new.
	raw do: [ :entry |
		| value |
		value := self logprobValueFrom: entry.
		value ifNotNil: [ numbers add: value ].
		numbers size >= self lowConfidenceLogprobTokenLimit ifTrue: [ ^ numbers asArray ] ].

	^ numbers asArray
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> logprobValueFrom: anObject [

	| value |
	anObject ifNil: [ ^ nil ].
	value := (anObject respondsTo: #at:ifAbsent:)
		ifTrue: [
			anObject
				at: #logprob
				ifAbsent: [ anObject at: 'logprob' ifAbsent: [ nil ] ] ]
		ifFalse: [ anObject ].

	value ifNil: [ ^ nil ].
	(value isKindOf: Number) ifTrue: [ ^ value ].
	^ [ value asNumber ]
		on: Error
		do: [ nil ]
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> lowConfidenceAverageLogprobThreshold [

	^ -3.0
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> lowConfidenceLogprobTokenLimit [

	^ 5
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> logNoEntriesAfterCleaningFor: contentCollection [

	self isLoggingEnabled ifFalse: [ ^ self ].
	CoPharoCopilotLogger logFrontEndEvent: 'Skipping completion menu: no entries after cleaning' details: (
		Dictionary new
			at: #rawSuggestionCount put: contentCollection size;
			yourself
	)
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> logCompletionReroutedToComplishonFor: aContext prefix: prefixString suffix: suffixString [

	| prefix suffix route environment |
	self isLoggingEnabled ifFalse: [ ^ self ].

	prefix := prefixString ifNil: [ '' ] ifNotNil: [ prefixString asString ].
	suffix := suffixString ifNil: [ '' ] ifNotNil: [ suffixString asString ].
	environment := self completionEnvironmentFor: aContext.
	route := [
		self completionRouter
			classifyContext: aContext
			prefix: prefix
			builder: self ]
		on: Error
		do: [ #unknown ].

	CoPharoCopilotLogger logCompletionReroutedToComplishon: (
		Dictionary new
			at: #reason put: #standaloneScriptingContext;
			at: #completionRoute put: route;
			at: #oldEngine put: #Complishon;
			at: #oldEngineBuilder put: #CoASTHeuristicsResultSetBuilder;
			at: #prefixSize put: prefix size;
			at: #suffixSize put: suffix size;
			at: #completionEnvironment put: environment;
			yourself)
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> logOldCompletionLookupFor: aContext reason: reasonSymbol [

	self isLoggingEnabled ifFalse: [ ^ self ].
	CoPharoCopilotLogger logOldCompletionLookup: (
		Dictionary new
			at: #reason put: reasonSymbol;
			at: #oldEngine put: #Complishon;
			at: #oldEngineBuilder put: #CoASTHeuristicsResultSetBuilder;
			at: #completionEnvironment put: (self completionEnvironmentFor: aContext);
			yourself)
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> logRejectedSuggestionFrom: rawResponse attempt: attempt prefix: prefixString [

	self isLoggingEnabled ifFalse: [ ^ self ].
	CoPharoCopilotLogger logBackEndEvent: 'Suggestion rejected after normalization' details: (
		Dictionary new
			at: #attempt put: attempt;
			at: #rawResponse put: rawResponse asString;
			at: #prefixTail put: ((prefixString size > 80)
				ifTrue: [ prefixString last: 80 ]
				ifFalse: [ prefixString ]);
			yourself
	)
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> logRejectedSuggestionFrom: rawResponse attempt: attempt prefix: prefixString contextInfo: contextInfo [

	| rejected sessionId |
	self isLoggingEnabled ifFalse: [ ^ self ].
	CoPharoCopilotLogger logBackEndEvent: 'Suggestion rejected after normalization' details: (Dictionary new
			 at: #attempt put: attempt;
			 at: #rawResponse put: rawResponse asString;
			 at: #prefixTail put: (prefixString size > 80
					  ifTrue: [ prefixString last: 80 ]
					  ifFalse: [ prefixString ]);
			 yourself).

	rejected := contextInfo at: #rejected ifAbsentPut: [ OrderedCollection new ].
	rejected add: rawResponse asString.

	sessionId := contextInfo at: #sessionId ifAbsent: [ nil ].
	sessionId ifNotNil: [ CoPharoCopilotLogger updateCompletionSession: sessionId addRejected: rawResponse asString ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> logStaleContextForExpectedPrefix: expectedPrefix suffix: expectedSuffix context: aContext [

	| snapshot currentPrefix currentSuffix |
	self isLoggingEnabled ifFalse: [ ^ self ].
	snapshot := self liveContextSnapshotFor: aContext.
	currentPrefix := snapshot at: #prefix ifAbsent: [ '' ].
	currentSuffix := snapshot at: #suffix ifAbsent: [ '' ].

	CoPharoCopilotLogger logFrontEndEvent: 'Skipping completion menu: stale context' details: (
		Dictionary new
			at: #expectedPrefixTail put: ((expectedPrefix ifNil: [ '' ]) size > 80
				ifTrue: [ (expectedPrefix ifNil: [ '' ]) last: 80 ]
				ifFalse: [ expectedPrefix ifNil: [ '' ] ]);
			at: #currentPrefixTail put: (currentPrefix size > 80
				ifTrue: [ currentPrefix last: 80 ]
				ifFalse: [ currentPrefix ]);
			at: #expectedSuffixHead put: ((expectedSuffix ifNil: [ '' ]) size > 80
				ifTrue: [ (expectedSuffix ifNil: [ '' ]) first: 80 ]
				ifFalse: [ expectedSuffix ifNil: [ '' ] ]);
			at: #currentSuffixHead put: (currentSuffix size > 80
				ifTrue: [ currentSuffix first: 80 ]
				ifFalse: [ currentSuffix ]);
			at: #position put: (snapshot at: #position ifAbsent: [ nil ]);
			at: #sourceLength put: (snapshot at: #sourceLength ifAbsent: [ nil ]);
			yourself
	).

	^ self
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> menuClosed [
	"Called when the menu is closed externally."

	menuMorph := nil
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> menuLabelForSuggestion: suggestionString contextInfo: contextInfo [

	| label newlineIndex |

	label := (suggestionString ifNil: [ '' ]) asString.

	newlineIndex := label indexOf: Character lf ifAbsent: [ 0 ].
	newlineIndex > 0 ifTrue: [
		label := label copyFrom: 1 to: newlineIndex - 1 ].

	label := label trimBoth.

	^ label size > 80
		ifTrue: [ (label copyFrom: 1 to: 77), '…' ]
		ifFalse: [ label ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> menuPositionFor: aContext [

	| engine editor token |
	engine := [ aContext engine ] on: Error do: [ nil ].
	engine ifNil: [ ^ self fallbackMenuPositionFor: aContext ].

	editor := [ engine editor ] on: Error do: [ nil ].
	editor ifNil: [ ^ self fallbackMenuPositionFor: aContext ].

	token := [ engine completionToken ]
		on: Error
		do: [ [ aContext completionToken ] on: Error do: [ '' ] ].

	"Use the exact same anchor API as Complishon"
	^ [ editor selectionPosition: token ]
		on: Error
		do: [ self fallbackMenuPositionFor: aContext ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> menuPositionForContextOrDefault: aContext [

	| position |
	position := self menuPositionFor: aContext.

	position ifNil: [
		self isLoggingEnabled ifTrue: [
			CoPharoCopilotLogger logFrontEndEvent: 'Completion menu position unavailable' details: (
				Dictionary new
					at: #contextClass put: aContext class name;
					at: #hasEditorAccessor put: (aContext respondsTo: #editor);
					yourself
			) ].
			^ 200 @ 200 ].

	^ position
]

CoPharoCopilotResultSetBuilder >> methodClassForBehavior: behavior selector: selector [

	| compiledMethod |
	compiledMethod := selector
		ifNotNil: [ behavior compiledMethodAt: selector ifAbsent: [ nil ] ]
		ifNil: [ nil ].

	^ compiledMethod
		ifNotNil: [ compiledMethod methodClass ]
		ifNil: [ behavior ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> methodSourcesFor: aBehavior [
	"Collect and concatenate the source of all methods of the given behavior (sorted), ignoring failures."

	aBehavior ifNil: [ ^ '' ].

	^ String streamContents: [ :stream |
		[
			(aBehavior selectors asSortedCollection) do: [ :selector |
				| source |
				source := [ aBehavior sourceCodeAt: selector ] on: Error do: [ nil ].
				source ifNotNil: [
					stream
						nextPutAll: source;
						cr;
						cr ] ] ]
			on: Error
			do: [ ] ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> methodSourcesFor: aBehavior around: aSelector limit: limitInteger [

	"Only a window of methods; avoids huge prompt building. The sorted-selector array is
	cached per (behavior, methodDict identity, methodDict size) so we don't re-sort on every
	completion."
	| sorted idx half start end |
	aBehavior ifNil: [ ^ '' ].

	sorted := self sortedSelectorsFor: aBehavior.
	sorted isEmpty ifTrue: [ ^ '' ].

	idx := (aSelector isNil)
		ifTrue: [ 1 ]
		ifFalse: [ sorted indexOf: aSelector ifAbsent: [ 1 ] ].
	half := limitInteger // 2.
	start := (idx - half) max: 1.
	end := (start + limitInteger - 1) min: sorted size.
	start := (end - limitInteger + 1) max: 1.
	^ String streamContents: [ :stream |
		(start to: end) do: [ :i |
			| sel src |
			sel := sorted at: i.
			src := [ aBehavior sourceCodeAt: sel ] on: Error do: [ nil ].
			src ifNotNil: [
				stream nextPutAll: src; cr; cr ] ] ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> minimumPrefixLength [
	"Minimum prefix length required before we request a completion."

	^ CopilotSettings minimumPrefixLength
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> nearMatchCachedSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext [

	^ self completionCache
		nearMatchAt: prefixString
		suffix: suffixString
		context: classContext
		ifPresent: [ :cached | self filteredNearMatchSuggestions: cached forPrefix: prefixString ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> normalizeSuggestion: rawResponse forPrefix: prefixString [

	| raw text cleaned typedFragment |
	raw := self extractResponseContentFromRaw: rawResponse. 
	text := self removeEchoedPrefix: raw prefix: prefixString. 
	cleaned := self cleanedContentFrom: text. 
	typedFragment := self trailingWordFragmentIn: prefixString.
	cleaned := self stripTypedFragment: typedFragment fromSuggestion: cleaned. 
	(self isTemplateLeakOrPromptEcho: cleaned rawResponse: raw prefix: prefixString) ifTrue: [ ^ '' ].

	(self isLikelyContextEcho: cleaned forPrefix: prefixString typedFragment: typedFragment) ifTrue: [ ^ '' ].
	(self isBadCompletionShape: cleaned) ifTrue: [ ^ '' ].

	^ cleaned trimBoth
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> normalizedCompletionContentsFrom: contentCollection inContext: aContext contextInfo: contextInfo [

	| prefix typedFragment completionKind |
	prefix := contextInfo
		ifNil: [
			(aContext isNil)
				ifTrue: [ '' ]
				ifFalse: [ (self contextSnapshotFor: aContext) at: #prefix ifAbsent: [ '' ] ] ]
		ifNotNil: [
			contextInfo
				at: #prefix
				ifAbsent: [
					(aContext isNil)
						ifTrue: [ '' ]
						ifFalse: [ (self contextSnapshotFor: aContext) at: #prefix ifAbsent: [ '' ] ] ] ].
	typedFragment := self completionTokenFor: aContext prefix: prefix.
	completionKind := self completionKindFor: aContext prefix: prefix.

	^ ((contentCollection ifNil: [ #() ]) collect: [ :each |
			self
				stripTypedFragment: typedFragment
				fromSuggestion: (self cleanedContentFrom: each) ])
		select: [ :each |
			each isEmpty not and: [
				self
					isSuggestion: each
					acceptableForCompletionKind: completionKind ] ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> semanticSelectorFastPathEntriesFor: aContext contextInfo: contextInfo [

	^ #()
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> normalizedSuggestionFrom: client prefix: prefixString suffix: suffixString context: classContext attempt: attempt [

	| rawResponse content |
	rawResponse := client generateForPrefix: prefixString suffix: suffixString context: classContext.
	content := self normalizeSuggestion: rawResponse forPrefix: prefixString.

	(content isEmpty and: [ rawResponse asString trimBoth isEmpty not ]) ifTrue: [
		self logRejectedSuggestionFrom: rawResponse attempt: attempt prefix: prefixString
	].

	^ content
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> normalizedSuggestionFrom: client prefix: prefixString suffix: suffixString context: classContext attempt: attempt contextInfo: contextInfo [

	^ self
		normalizedSuggestionFrom: client
		prefix: prefixString
		suffix: suffixString
		context: classContext
		attempt: attempt
		contextInfo: contextInfo
		requestOptions: nil
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> normalizedSuggestionFrom: client prefix: prefixString suffix: suffixString context: classContext attempt: attempt contextInfo: contextInfo requestOptions: requestOptions [

	| metadata rawResponse content |
	metadata := ((requestOptions notNil and: [ requestOptions isEmpty not ])
		and: [ client respondsTo: #generateWithMetadataForPrefix:suffix:context:options: ])
		ifTrue: [
			client
				generateWithMetadataForPrefix: prefixString
				suffix: suffixString
				context: classContext
				options: requestOptions ]
		ifFalse: [
			(client respondsTo: #generateWithMetadataForPrefix:suffix:context:)
				ifTrue: [
					client
						generateWithMetadataForPrefix: prefixString
						suffix: suffixString
						context: classContext ]
				ifFalse: [
					Dictionary new
						at: #content put: (client generateForPrefix: prefixString suffix: suffixString context: classContext);
						yourself ] ].
	rawResponse := metadata at: #content ifAbsent: [ '' ].
	content := self normalizeSuggestion: rawResponse forPrefix: prefixString.
	(content isEmpty not and: [ self isLowConfidenceMetadata: metadata ]) ifTrue: [
		content := '' ].
	self recordGenerationAttempt: attempt metadata: metadata normalizedSuggestion: content contextInfo: contextInfo.

	(content isEmpty and: [ rawResponse asString trimBoth isEmpty not ]) ifTrue: [
		self
			logRejectedSuggestionFrom: rawResponse
			attempt: attempt
			prefix: prefixString
			contextInfo: contextInfo
	].

	^ content
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> ollamaClient [ 

	^ cachedClient ifNil: [ cachedClient := CoPCOllamaClient new ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> recordGenerationAttempt: attempt metadata: metadata normalizedSuggestion: content contextInfo: contextInfo [

	| attempts attemptPayload average |
	self isLoggingEnabled ifFalse: [ ^ self ].
	contextInfo ifNil: [ ^ self ].

	attempts := contextInfo at: #generationAttempts ifAbsentPut: [ OrderedCollection new ].
	attemptPayload := Dictionary new
		at: #attempt put: attempt;
		at: #suggestion put: content;
		at: #request put: (metadata at: #request ifAbsent: [ Dictionary new ]);
		at: #response put: (metadata at: #response ifAbsent: [ Dictionary new ]);
		yourself.
	average := self averageLogprobFromMetadata: metadata.
	average ifNotNil: [
		attemptPayload
			at: #averageLogprob put: average;
			at: #lowConfidence put: average < self lowConfidenceAverageLogprobThreshold ].
	attempts add: attemptPayload
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> openCompletionMenuFor: aContext entries: entries position: position [ 

	self deferUI: [
		[
			menuMorph := aContext engine
				openCopilotMenuFor: aContext
				entries: entries
				position: position
				builder: self
		]
			on: Error
			do: [ :ex |
				CoPharoCopilotLogger
					logError: 'Failed to open completion menu'
					origin: #CoPharoCopilotResultSetBuilder
					exception: ex
					payload: (
						Dictionary new
							at: #entryCount put: entries size;
							at: #position put: position printString;
							yourself ) ]
	]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> openCachedSuggestions: suggestions for: aContext prefix: prefixString suffix: suffixString contextInfo: contextInfo [

	| entries position info |
	info := contextInfo ifNil: [ Dictionary new ].
	entries := self
		completionEntriesFrom: suggestions
		inContext: aContext
		contextInfo: info.
	entries isEmpty ifTrue: [ ^ false ].

	position := self menuPositionForContextOrDefault: aContext.
	self openCompletionMenuFor: aContext entries: entries position: position.
	^ true
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> positionFromSnapshot: snapshot [

	^ snapshot at: #position ifAbsent: [ 0 ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> prependNavigationHistoryTo: contextString [
	"Compatibility wrapper for old callers. The behavior is append, not prepend:
	history belongs at the end of the context block just before the FIM tail."

	^ self appendInteractionHistoryToContext: contextString
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> processCompletionFor: aContext prefix: prefixString suffix: suffixString contextInfo: contextInfo [

	[
		| classContext suggestions sessionId sessionPayload loggingOn |

		contextInfo ifNotNil: [
			contextInfo
				at: #completionRoute
				put: (self completionRouter
					classifyContext: aContext
					prefix: prefixString
					builder: self) ].

		classContext := self classContextFor: aContext prefix: prefixString.
		loggingOn := self isLoggingEnabled.
		loggingOn ifTrue: [
			self updateContextInfo: contextInfo withClassContext: classContext.
			contextInfo at: #classContext put: classContext ].

		suggestions := self cachedSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext contextInfo: contextInfo.
		suggestions ifNil: [
			suggestions := self fetchSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext contextInfo: contextInfo.
			self cacheSuggestions: suggestions prefix: prefixString suffix: suffixString classContext: classContext
		].
		self cacheFastSuggestions: suggestions for: aContext prefix: prefixString suffix: suffixString.

		loggingOn ifTrue: [
			sessionId := contextInfo at: #sessionId ifAbsent: [ nil ].
			sessionId ifNotNil: [
				sessionPayload := CoPharoCopilotLogger
					initialCompletionPayloadForContextInfo: contextInfo
					prefix: prefixString
					suffix: suffixString
					classContext: classContext
					cacheStats: self completionCache statisticsDictionary.
				CoPharoCopilotLogger
					writeCompletionSession: sessionPayload
					sessionId: sessionId ] ].

		self
			applyContents: suggestions
			toContext: aContext
			expectedPrefix: prefixString
			suffix: suffixString
			contextInfo: contextInfo
	]
		on: Error
		do: [ :ex |  ]

]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> removeEchoedPrefix: contentString prefix: prefixString [
	"Strip the user prefix when the model echoes it back.
	Works for exact echo, leading whitespace, and fenced answers."

	| content prefix trimmedContent trimmedPrefix |
	content := (contentString ifNil: [ '' ]) asString.
	prefix := (prefixString ifNil: [ '' ]) asString.

	(content isEmpty or: [ prefix isEmpty ]) ifTrue: [ ^ content ].

	(content beginsWith: prefix) ifTrue: [
		^ content allButFirst: prefix size ].

	trimmedContent := content trimLeft.
	(trimmedContent beginsWith: prefix) ifTrue: [
		^ (trimmedContent allButFirst: prefix size) trimLeft ].

	trimmedPrefix := prefix trimRight.
	(trimmedPrefix isEmpty not and: [ trimmedContent beginsWith: trimmedPrefix ]) ifTrue: [
		^ (trimmedContent allButFirst: trimmedPrefix size) trimLeft ].

	((trimmedContent beginsWith: '```') and: [ trimmedContent includesSubstring: prefix ]) ifTrue: [
		| unfenced |
		unfenced := self cleanedContentFrom: trimmedContent.
		(unfenced beginsWith: prefix) ifTrue: [
			^ unfenced allButFirst: prefix size ] ].

	^ content
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> repoContextForClass: aClass definition: classDefinitionString instanceMethods: instanceMethodsString classMethods: classMethodsString [
	"Format the class context in the repo-level marker layout the completion models were
	fine-tuned on (<|repo_name|> / <|file_sep|> sections), instead of English prose
	headers the models never saw during training."

	| hasDefinition hasInstance hasClass lf |
	hasDefinition := classDefinitionString isEmpty not.
	hasInstance := instanceMethodsString isEmpty not.
	hasClass := classMethodsString isEmpty not.

	(hasDefinition or: [ hasInstance or: hasClass ]) ifFalse: [ ^ '' ].

	lf := Character lf.
	^ String streamContents: [ :stream |
		stream
			nextPutAll: '<|repo_name|>';
			nextPutAll: aClass name;
			nextPut: lf.

		hasDefinition ifTrue: [
			stream
				nextPutAll: '<|file_sep|>';
				nextPutAll: aClass name;
				nextPut: lf;
				nextPutAll: classDefinitionString;
				nextPut: lf ].

		hasInstance ifTrue: [
			stream
				nextPutAll: '<|file_sep|>';
				nextPutAll: aClass name , ' (instance side)';
				nextPut: lf;
				nextPutAll: instanceMethodsString;
				nextPut: lf ].

		hasClass ifTrue: [
			stream
				nextPutAll: '<|file_sep|>';
				nextPutAll: aClass name , ' (class side)';
				nextPut: lf;
				nextPutAll: classMethodsString;
				nextPut: lf ] ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> requestDelayForSnapshot: snapshot [

	| source position |
	source := self sourceFromSnapshot: snapshot.
	position := self positionFromSnapshot: snapshot.
	^ self requestDelayForSource: source position: position
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> requestDelayForSource: source position: pos [
	| before |
	before := pos > 0 ifTrue: [ source at: pos ] ifFalse: [ nil ].

	"Fast when user just hit a boundary (like space)."
	(self isTriggerBoundaryChar: before) ifTrue: [ ^ self debounceMilliseconds ].

	"Otherwise wait for real idle."
	^ self idleMilliseconds
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> safeDefinitionStringFor: aBehavior [
	"Return the class definition string for a behavior, or empty string if unavailable."

	aBehavior ifNil: [ ^ '' ].
	^ [ aBehavior definition asString ] on: Error do: [ '' ]
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> safeSourceAndPositionFor: aContext [
	| source pos |
	source := [ aContext source ifNil: [ '' ] ] on: Error do: [ '' ].
	pos := [ aContext position ifNil: [ 0 ] ] on: Error do: [ 0 ].
	pos := (pos max: 0) min: source size.
	^ { source. pos }
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> scanClassContextOldestKey [

	| bestKey bestTime |
	bestKey := nil.
	bestTime := nil.
	classContextCache keysAndValuesDo: [ :k :v |
		| t |
		t := v at: #accessTime ifAbsent: [ 0 ].
		(bestTime isNil or: [ t < bestTime ]) ifTrue: [
			bestKey := k.
			bestTime := t ] ].
	classContextOldestKey := bestKey.
	classContextOldestTime := bestTime.
	^ bestKey
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> annotatedSemanticAstFor: aContext source: sourceString [

	| behavior compiler ast visitorClass |
	behavior := self behaviorFor: aContext.
	behavior ifNil: [ ^ nil ].
	(behavior respondsTo: #compiler) ifFalse: [ ^ nil ].

	ast := [
		compiler := behavior compiler.
		compiler source: sourceString.
		(compiler respondsTo: #isScripting:) ifTrue: [
			compiler isScripting: (self isScriptingContext: aContext) ].
		compiler parse ]
		on: Error
		do: [ nil ].
	ast ifNil: [ ^ nil ].

	visitorClass := self typeAnnotationVisitorClass.
	visitorClass ifNotNil: [
		[ visitorClass new visit: ast ]
			on: Error
			do: [ ] ].

	^ ast
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> completionTokenFor: aContext prefix: prefixString [

	| token |
	token := (aContext notNil and: [ aContext respondsTo: #completionToken ])
		ifTrue: [ [ aContext completionToken ] on: Error do: [ nil ] ]
		ifFalse: [ nil ].

	(token isNil or: [ token asString isEmpty ]) ifFalse: [ ^ token asString ].
	^ self trailingWordFragmentIn: prefixString
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> environmentValueNamed: variableName inContext: aContext ifPresent: aBlock [

	| symbol value found |
	variableName ifNil: [ ^ self ].
	variableName asString isEmpty ifTrue: [ ^ self ].
	symbol := variableName asString asSymbol.

	(aContext notNil and: [ aContext respondsTo: #environmentAt:ifPresent: ]) ifTrue: [
		found := false.
		[
			aContext
				environmentAt: symbol
				ifPresent: [ :global |
					value := global.
					found := true ] ]
			on: Error
			do: [ ].
		found ifTrue: [ ^ aBlock value: value ] ].

	value := [ Smalltalk globals at: symbol ifAbsent: [ nil ] ]
		on: Error
		do: [ nil ].
	value ifNotNil: [ ^ aBlock value: value ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> inferredInstanceVariableTypesNamed: variableName inBehavior: aBehavior [

	| inferencerClass variables |
	(aBehavior isNil or: [ variableName isNil ]) ifTrue: [ ^ #() ].

	inferencerClass := Smalltalk globals
		at: #CoTypeInferencer
		ifAbsent: [ nil ].
	inferencerClass ifNil: [ ^ #() ].

	variables := [
		inferencerClass new
			inferFrom: aBehavior;
			variables ]
		on: Error
		do: [ nil ].
	variables ifNil: [ ^ #() ].

	^ variables at: variableName asString ifAbsent: [ #() ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> isClassOrTrait: anObject [

	anObject ifNil: [ ^ false ].
	((anObject respondsTo: #isClassOrTrait) and: [
		[ anObject isClassOrTrait ] on: Error do: [ false ] ])
			ifTrue: [ ^ true ].
	^ [ anObject isBehavior ] on: Error do: [ false ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> isScriptingContext: aContext [

	| engine |
	aContext ifNil: [ ^ false ].

	(aContext respondsTo: #isScripting) ifTrue: [
		^ [ aContext isScripting ] on: Error do: [ false ] ].

	engine := self engineFor: aContext.

	^ (engine notNil and: [ engine respondsTo: #isScripting ])
		and: [ [ engine isScripting ] on: Error do: [ false ] ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> doItContextFor: aContext [

	| engine |
	aContext ifNil: [ ^ nil ].
	(aContext respondsTo: #doItContext) ifTrue: [
		| context |
		context := [ aContext doItContext ] on: Error do: [ nil ].
		context ifNotNil: [ ^ context ] ].

	engine := self engineFor: aContext.
	^ (engine notNil and: [ engine respondsTo: #doItContext ])
		ifTrue: [ [ engine doItContext ] on: Error do: [ nil ] ]
		ifFalse: [ nil ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> doItRequestorFor: aContext [

	| engine |
	aContext ifNil: [ ^ nil ].
	(aContext respondsTo: #doItRequestor) ifTrue: [
		| requestor |
		requestor := [ aContext doItRequestor ] on: Error do: [ nil ].
		requestor ifNotNil: [ ^ requestor ] ].

	engine := self engineFor: aContext.
	^ (engine notNil and: [ engine respondsTo: #doItRequestor ])
		ifTrue: [ [ engine doItRequestor ] on: Error do: [ nil ] ]
		ifFalse: [ nil ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> isSemanticMessageNode: aNode [

	aNode ifNil: [ ^ false ].
	((aNode respondsTo: #isMessage) and: [
		[ aNode isMessage ] on: Error do: [ false ] ])
			ifTrue: [ ^ true ].
	^ (aNode respondsTo: #receiver) and: [ aNode respondsTo: #selector ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> isUnknownSemanticType: aType [

	aType ifNil: [ ^ true ].
	aType class name = #CoUnknownType ifTrue: [ ^ true ].
	^ (self typeNameFor: aType) = 'CoUnknownType'
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> liveVariableValueNamed: variableName inContext: aContext ifPresent: aBlock [

	| name doItContext variable requestor binding |
	(aContext isNil or: [ variableName isNil ]) ifTrue: [ ^ self ].
	name := variableName asString.
	name isEmpty ifTrue: [ ^ self ].

	doItContext := self doItContextFor: aContext.
	doItContext ifNotNil: [
		variable := [
			(doItContext respondsTo: #lookupVar:)
				ifTrue: [ doItContext lookupVar: name ]
				ifFalse: [ nil ] ]
			on: Error
			do: [ nil ].
		variable ifNotNil: [
			^ aBlock value: ([ variable readInContext: doItContext ] on: Error do: [ nil ]) ] ].

	requestor := self doItRequestorFor: aContext.
	requestor ifNil: [ ^ self ].

	((requestor respondsTo: #hasBindingOf:) and: [
		[ requestor hasBindingOf: name ] on: Error do: [ false ] ])
			ifFalse: [ ^ self ].

	binding := [
		(requestor respondsTo: #bindingOf:)
			ifTrue: [ requestor bindingOf: name ]
			ifFalse: [ nil ] ]
		on: Error
		do: [ nil ].
	binding ifNil: [ ^ self ].

	^ aBlock value: ([ binding value ] on: Error do: [ nil ])
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> modelForRequestor: requestor [

	requestor ifNil: [ ^ nil ].
	^ (requestor respondsTo: #model)
		ifTrue: [ [ requestor model ] on: Error do: [ requestor ] ]
		ifFalse: [ requestor ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> normalizeSemanticTypes: typeCollection [

	| normalized seen |
	normalized := OrderedCollection new.
	seen := Set new.
	typeCollection ifNil: [ ^ #() ].

	typeCollection do: [ :type |
		| name |
		(self isUnknownSemanticType: type) ifFalse: [
			name := self typeNameFor: type.
			(name isEmpty or: [ seen includes: name ]) ifFalse: [
				seen add: name.
				normalized add: type ] ] ].

	^ normalized asArray
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> scheduleCompletionFor: aContext prefix: prefixString suffix: suffixString contextInfo: contextInfo [
	^ self
		scheduleCompletionFor: aContext
		prefix: prefixString
		suffix: suffixString
		contextInfo: contextInfo
		delayMilliseconds: self debounceMilliseconds
]

{ #category : 'API - building' }
CoPharoCopilotResultSetBuilder >> scheduleCompletionFor: aContext prefix: prefixString suffix: suffixString contextInfo: contextInfo delayMilliseconds: delayMs [
	"Debounce: cancel pending, schedule only latest."

	| token priority delay |
	debounceToken ifNil: [ debounceToken := 0 ].
	debounceToken := debounceToken + 1.
	token := debounceToken.
	delay := delayMs ifNil: [ 0 ].

	debounceProcess ifNotNil: [ debounceProcess terminate ].

	priority := (Processor class includesSelector: #userSchedulingPriority)
		ifTrue: [ Processor userSchedulingPriority ]
		ifFalse: [ Processor userBackgroundPriority ].

	debounceProcess := [
		delay > 0 ifTrue: [
			(Delay forMilliseconds: delay) wait ].
		token = debounceToken ifTrue: [
			self
				processCompletionFor: aContext
				prefix: prefixString
				suffix: suffixString
				contextInfo: contextInfo ] ] forkAt: priority
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> receiverNameForNode: aNode source: sourceString [

	| sourceName |
	aNode ifNil: [ ^ '' ].

	sourceName := self sourceSubstringForNode: aNode in: sourceString.
	sourceName isEmpty ifFalse: [ ^ sourceName ].

	((aNode respondsTo: #isSelfVariable) and: [
		[ aNode isSelfVariable ] on: Error do: [ false ] ])
			ifTrue: [ ^ 'self' ].
	((aNode respondsTo: #isSuperVariable) and: [
		[ aNode isSuperVariable ] on: Error do: [ false ] ])
			ifTrue: [ ^ 'super' ].
	(aNode respondsTo: #name) ifTrue: [
		^ [ aNode name asString ] on: Error do: [ '' ] ].
	(aNode respondsTo: #value) ifTrue: [
		^ [ aNode value printString ] on: Error do: [ '' ] ].

	^ ''
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> receiverNodeForSemanticNode: aNode [

	aNode ifNil: [ ^ nil ].
	(self isSemanticMessageNode: aNode) ifTrue: [
		^ [ aNode receiver ] on: Error do: [ nil ] ].

	((aNode respondsTo: #propertyAt:ifAbsent:) or: [
		(aNode respondsTo: #name) or: [ aNode respondsTo: #value ] ])
			ifTrue: [ ^ aNode ].

	^ nil
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> semanticAstNodeFor: aContext source: sourceString position: positionInteger [

	| ast position |
	ast := self annotatedSemanticAstFor: aContext source: sourceString.
	ast ifNil: [ ^ nil ].

	position := (positionInteger ifNil: [ 0 ]) max: 0.
	^ [
		(ast nodeBeforeOffset: position)
			ifNil: [ ast ] ]
		on: Error
		do: [ ast ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> semanticCompletionContextFor: aContext prefix: prefixString [

	| lines behavior token receiverInfo receiverName receiverTypes selectorHints bindings lf |
	aContext ifNil: [ ^ '' ].

	lines := OrderedCollection new.
	behavior := self behaviorFor: aContext.
	behavior ifNotNil: [
		lines add: 'Completion class: ' , (self typeNameFor: behavior) ].

	token := self completionTokenFor: aContext prefix: prefixString.
	token isEmpty ifFalse: [
		lines add: 'Typed token: ' , token ].

	receiverInfo := self semanticReceiverInfoFor: aContext prefix: prefixString.
	receiverName := receiverInfo at: #receiver ifAbsent: [ '' ].
	receiverTypes := receiverInfo at: #types ifAbsent: [ #() ].

	receiverName isEmpty ifFalse: [
		lines add: 'Current receiver: ' , receiverName ].
	receiverTypes isEmpty ifFalse: [
		lines add: 'Receiver type: ' , (self typeNamesStringFor: receiverTypes) ].

	selectorHints := self
		semanticSelectorHintsForTypes: receiverTypes
		token: token
		limit: 8.
	selectorHints isEmpty ifFalse: [
		lines add: (token isEmpty
			ifTrue: [ 'Receiver selector samples:' ]
			ifFalse: [ 'Receiver selectors matching ' , token printString , ':' ]).
		selectorHints do: [ :selector |
			lines add: '  ' , selector ] ].

	bindings := self visibleBindingTypeDescriptionsFor: aContext limit: 12.
	bindings isEmpty ifFalse: [
		lines add: 'Visible binding types:'.
		bindings do: [ :bindingDescription |
			lines add: '  ' , bindingDescription ] ].

	lines isEmpty ifTrue: [ ^ '' ].
	lf := Character lf.
	^ String streamContents: [ :stream |
		lines
			do: [ :line | stream nextPutAll: line ]
			separatedBy: [ stream nextPut: lf ] ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> semanticReceiverInfoFor: aContext prefix: prefixString [

	| source position behavior key cached node receiverNode receiverName receiverTypes token info |
	source := [ aContext source ifNil: [ prefixString ifNil: [ '' ] ] ]
		on: Error
		do: [ prefixString ifNil: [ '' ] ].
	position := [ aContext position ifNil: [ source size ] ]
		on: Error
		do: [ source size ].
	position := (position max: 0) min: source size.
	behavior := self behaviorFor: aContext.
	key := self
		semanticReceiverInfoCacheKeyForSource: source
		position: position
		behavior: behavior
		prefix: prefixString.
	cached := self cachedSemanticReceiverInfoForKey: key.
	cached ifNotNil: [ ^ cached ].

	node := self
		semanticAstNodeFor: aContext
		source: source
		position: position.
	receiverNode := self receiverNodeForSemanticNode: node.

	receiverName := receiverNode
		ifNil: [ '' ]
		ifNotNil: [ self receiverNameForNode: receiverNode source: source ].
	receiverName isEmpty ifTrue: [
		receiverName := self textualReceiverBeforeCompletionIn: prefixString ].

	receiverTypes := receiverNode
		ifNil: [ #() ]
		ifNotNil: [
			self
				semanticTypesForReceiverNode: receiverNode
				inContext: aContext
				behavior: behavior
				source: source ].

	token := self completionTokenFor: aContext prefix: prefixString.
	(receiverTypes isEmpty and: [
		token isEmpty not and: [ receiverName = token ] ]) ifTrue: [
			receiverName := self textualReceiverBeforeCompletionIn: prefixString.
			receiverTypes := self
				semanticTypesForReceiverName: receiverName
				inContext: aContext
				behavior: behavior ].

	(receiverTypes isEmpty and: [ receiverName isEmpty not ]) ifTrue: [
		receiverTypes := self
			semanticTypesForReceiverName: receiverName
			inContext: aContext
			behavior: behavior ].

	info := Dictionary new
		at: #receiver put: receiverName;
		at: #types put: receiverTypes;
		yourself.
	^ self cacheSemanticReceiverInfo: info forKey: key
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> cacheSemanticReceiverInfo: info forKey: key [

	lastSemanticReceiverKey := key.
	lastSemanticReceiverValue := info.
	^ info
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> semanticReceiverInfoCacheKeyForSource: sourceString position: positionInteger behavior: aBehavior prefix: prefixString [

	^ {
		sourceString.
		positionInteger.
		aBehavior.
		prefixString ifNil: [ '' ] ifNotNil: [ prefixString asString ] }
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> semanticSelectorHintsForTypes: typeCollection token: tokenString limit: limitInteger [

	| selectors token limit sorted |
	selectors := Set new.
	token := tokenString ifNil: [ '' ] ifNotNil: [ tokenString asString ].
	limit := limitInteger ifNil: [ 30 ].

	(self normalizeSemanticTypes: typeCollection) do: [ :type |
		| current |
		current := type.
		[ current notNil ] whileTrue: [
			[
				current selectorsDo: [ :selector |
					| selectorString |
					selectorString := selector asString.
					(token isEmpty or: [ selectorString beginsWith: token ])
						ifTrue: [ selectors add: selectorString ] ] ]
				on: Error
				do: [ ].
			current := [ current superclass ] on: Error do: [ nil ] ] ].

	sorted := selectors asArray asSortedCollection asArray.
	sorted size <= limit ifTrue: [ ^ sorted ].
	^ sorted copyFrom: 1 to: limit
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> semanticTypesForReceiverName: receiverName inContext: aContext behavior: aBehavior [

	| name types inferred |
	receiverName ifNil: [ ^ #() ].
	name := receiverName asString trimBoth.
	name isEmpty ifTrue: [ ^ #() ].
	types := OrderedCollection new.

	self
		liveVariableValueNamed: name
		inContext: aContext
		ifPresent: [ :value | types add: value class ].

	name = 'self' ifTrue: [
		aBehavior ifNotNil: [ types add: aBehavior ].
		^ self normalizeSemanticTypes: types ].

	name = 'super' ifTrue: [
		aBehavior ifNotNil: [
			([ aBehavior superclass ] on: Error do: [ nil ])
				ifNotNil: [ :superclass | types add: superclass ] ].
		^ self normalizeSemanticTypes: types ].

	self
		environmentValueNamed: name
		inContext: aContext
		ifPresent: [ :global |
			(self isClassOrTrait: global)
				ifTrue: [ types add: global classSide ]
				ifFalse: [ types add: global class ] ].

	name size > 1 ifTrue: [
		self
			environmentValueNamed: name allButFirst
			inContext: aContext
			ifPresent: [ :global |
				(self isClassOrTrait: global)
					ifTrue: [ types add: global instanceSide ]
					ifFalse: [ types add: global class ] ] ].

	name size > 2 ifTrue: [
		self
			environmentValueNamed: (name allButFirst: 2)
			inContext: aContext
			ifPresent: [ :global |
				(self isClassOrTrait: global)
					ifTrue: [ types add: global instanceSide ]
					ifFalse: [ types add: global class ] ] ].

	inferred := self
		inferredInstanceVariableTypesNamed: name
		inBehavior: aBehavior.
	types addAll: inferred.

	^ self normalizeSemanticTypes: types
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> semanticTypesForReceiverNode: receiverNode inContext: aContext behavior: aBehavior source: sourceString [

	| types annotatedType receiverName |
	types := OrderedCollection new.
	annotatedType := self typePropertyOfNode: receiverNode.
	annotatedType ifNotNil: [ types add: annotatedType ].

	types isEmpty ifTrue: [
		((receiverNode respondsTo: #isLiteralNode) and: [
			[ receiverNode isLiteralNode ] on: Error do: [ false ] ])
				ifTrue: [
					[ types add: receiverNode value class ]
						on: Error
						do: [ ] ] ].

	receiverName := self receiverNameForNode: receiverNode source: sourceString.
	(types isEmpty and: [ receiverName isEmpty not ]) ifTrue: [
		types addAll: (self
			semanticTypesForReceiverName: receiverName
			inContext: aContext
			behavior: aBehavior) ].

	^ self normalizeSemanticTypes: types
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> sourceSubstringForNode: aNode in: sourceString [

	| source start stop |
	(aNode isNil or: [ sourceString isNil ]) ifTrue: [ ^ '' ].
	source := sourceString asString.
	source isEmpty ifTrue: [ ^ '' ].

	start := [ aNode start ] on: Error do: [ nil ].
	stop := [
		(aNode respondsTo: #stopWithoutParentheses)
			ifTrue: [ aNode stopWithoutParentheses ]
			ifFalse: [ aNode stop ] ]
		on: Error
		do: [ nil ].

	(start isNil or: [ stop isNil ]) ifTrue: [ ^ '' ].
	start := start max: 1.
	stop := stop min: source size.
	start > stop ifTrue: [ ^ '' ].

	^ (source copyFrom: start to: stop) trimBoth
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> textualReceiverBeforeCompletionIn: prefixString [

	| prefix fragment base end start |
	prefix := prefixString ifNil: [ '' ] ifNotNil: [ prefixString asString ].
	prefix isEmpty ifTrue: [ ^ '' ].

	fragment := self trailingWordFragmentIn: prefix.
	base := prefix.
	(fragment isEmpty not and: [ base size >= fragment size ]) ifTrue: [
		((base copyFrom: base size - fragment size + 1 to: base size) = fragment)
			ifTrue: [
				base := base size = fragment size
					ifTrue: [ '' ]
					ifFalse: [ base copyFrom: 1 to: base size - fragment size ] ] ].
	base := base trimRight.
	base isEmpty ifTrue: [ ^ '' ].
	(self hasStandaloneCompletionBoundaryBeforeTokenIn: base) ifTrue: [ ^ '' ].

	end := base size.
	[ end > 0 and: [ (self isWordChar: (base at: end)) not ] ] whileTrue: [
		end := end - 1 ].
	end = 0 ifTrue: [ ^ '' ].

	start := end.
	[ start > 0 and: [ self isWordChar: (base at: start) ] ] whileTrue: [
		start := start - 1 ].

	^ base copyFrom: start + 1 to: end
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> hasStandaloneCompletionBoundaryBeforeTokenIn: prefixString [

	| prefix last boundaryCharacters |
	prefix := prefixString ifNil: [ '' ] ifNotNil: [ prefixString asString trimRight ].
	prefix isEmpty ifTrue: [ ^ true ].
	(prefix endsWith: ':=') ifTrue: [ ^ true ].

	last := prefix last.
	boundaryCharacters := '.^([{:|,+-*/\~<>=@%&?!'.
	^ boundaryCharacters includes: last
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> selectorFromPrefix: prefixString [
	"The selector is determined by the method header (the first non-empty line up to the first
	statement separator). While the user types in the body the header is stable, so we cache
	the (header -> selector) mapping to skip the AST parse on every keystroke."

	| header |
	prefixString ifNil: [ ^ nil ].

	header := self selectorHeaderFor: prefixString.
	(lastSelectorPrefix notNil and: [ lastSelectorPrefix = header ]) ifTrue: [
		^ lastSelectorResult ].

	^ self computeAndCacheSelectorFromPrefix: prefixString header: header
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> selectorHeaderFor: aString [
	"Return the method-header substring (everything p to the first newline, capped at 256
	characters). Cheap to compute and stable while the user edits the method body."

	| size limit i ch |
	size := aString size.
	limit := size min: 256.
	i := 1.
	[ i <= limit ] whileTrue: [
		ch := aString at: i.
		(ch = Character lf or: [ ch = Character cr ])
			ifTrue: [ ^ aString copyFrom: 1 to: i - 1 ].
		i := i + 1 ].
	^ aString copyFrom: 1 to: limit
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> shouldRequestCompletionForContext: aContext [
	"NO trigger while cursor is inside the same word."
	| pair source pos before after |
	aContext ifNil: [ ^ false ].

	pair := self safeSourceAndPositionFor: aContext.
	source := pair first.
	pos := pair second.

	(pos < self minimumPrefixLength) ifTrue: [ ^ false ].

	before := pos > 0 ifTrue: [ source at: pos ] ifFalse: [ nil ].
	after := pos < source size ifTrue: [ source at: pos + 1 ] ifFalse: [ nil ].

	"Cursor inside a word => do NOT initialize completion engine."
	((self isWordChar: before) and: [ self isWordChar: after ]) ifTrue: [ ^ false ].

	(self isInsideCommentOrStringIn: source position: pos) ifTrue: [ ^ false ].

	^ true
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> shouldUseFallbackCompletionForContext: aContext prefix: prefixString [

	^ false
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> shouldOpenSemanticSelectorFastPathFor: aContext prefix: prefixString [

	^ false
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> shouldRequestCompletionForPrefix: prefixString suffix: suffixString [
	"Decide whether it's worth requesting a completion for the current prefix/suffix."

	prefixString ifNil: [ ^ false ].
	(prefixString size < self minimumPrefixLength) ifTrue: [ ^ false ].
	^ true
]

CoPharoCopilotResultSetBuilder >> sortedSelectorsFor: aBehavior [
	"Return a cached sorted-selectors array for aBehavior. Invalidates when the methodDict
	identity or size changes."

	| cache stamp entry |
	aBehavior ifNil: [ ^ #() ].
	cache := sortedSelectorsCache ifNil: [ sortedSelectorsCache := Dictionary new ].
	stamp := self classStampFor: aBehavior.
	entry := cache at: aBehavior ifAbsent: [ nil ].
	(entry notNil and: [ (entry at: 1) = stamp ])
		ifTrue: [ ^ entry at: 2 ].

	entry := { stamp. aBehavior selectors asSortedCollection asArray }.
	cache at: aBehavior put: entry.
	^ entry at: 2
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> sourceFromSnapshot: snapshot [

	| prefix suffix |
	prefix := snapshot at: #prefix ifAbsent: [ '' ].
	suffix := snapshot at: #suffix ifAbsent: [ '' ].
	^ prefix , suffix
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> stripAlreadyTyped: typedAheadString fromSuggestion: suggestionString [

	| suggestion typed maxOverlap overlap |
	suggestion := (suggestionString ifNil: [ '' ]) asString.
	typed := (typedAheadString ifNil: [ '' ]) asString.
	(suggestion isEmpty or: [ typed isEmpty ]) ifTrue: [ ^ suggestion ].

	(suggestion beginsWith: typed) ifTrue: [
		^ suggestion allButFirst: typed size ].

	(typed beginsWith: suggestion) ifTrue: [ ^ '' ].

	maxOverlap := suggestion size min: typed size.
	overlap := maxOverlap.
	[ overlap > 1 ] whileTrue: [
		((typed copyFrom: typed size - overlap + 1 to: typed size)
			= (suggestion copyFrom: 1 to: overlap))
				ifTrue: [ ^ suggestion allButFirst: overlap ].
		overlap := overlap - 1 ].

	^ suggestion
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> stripAlreadyTyped: typedAheadString fromSuggestions: contentCollection [

	typedAheadString isNil ifTrue: [ ^ contentCollection ].
	typedAheadString isEmpty ifTrue: [ ^ contentCollection ].

	^ contentCollection collect: [ :each |
		self
			stripAlreadyTyped: typedAheadString
			fromSuggestion: (self cleanedContentFrom: each) ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> stripTypedFragment: typedFragment fromSuggestion: suggestionString [

	| suggestion fragment trimmed |
	suggestion := (suggestionString ifNil: [ '' ]) asString.
	fragment := (typedFragment ifNil: [ '' ]) asString.

	fragment isEmpty ifTrue: [ ^ suggestion ].
	suggestion isEmpty ifTrue: [ ^ suggestion ].

	(suggestion beginsWith: fragment) ifTrue: [
		^ suggestion allButFirst: fragment size ].

	trimmed := suggestion trimLeft.
	(trimmed beginsWith: fragment) ifTrue: [
		^ (trimmed allButFirst: fragment size) trimLeft ].

	^ suggestion
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> typedAheadIn: aContext expectedPrefix: expectedPrefix suffix: expectedSuffix [

	| snapshot currentPrefix currentSuffix |
	snapshot := self liveContextSnapshotFor: aContext.
	currentPrefix := snapshot at: #prefix ifAbsent: [ '' ].
	currentSuffix := snapshot at: #suffix ifAbsent: [ '' ].

	((currentPrefix beginsWith: expectedPrefix) and: [ currentSuffix = expectedSuffix ])
		ifFalse: [ ^ nil ].

	^ currentPrefix allButFirst: expectedPrefix size
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> trailingWordFragmentIn: aString [

	| text i |
	text := (aString ifNil: [ '' ]) asString.
	text isEmpty ifTrue: [ ^ '' ].

	i := text size.
	[ i > 0 and: [ self isWordChar: (text at: i) ] ] whileTrue: [
		i := i - 1 ].

	i = text size ifTrue: [ ^ '' ].
	^ text copyFrom: i + 1 to: text size
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> typeAnnotationVisitorClass [

	^ Smalltalk globals
		at: #OCTypingVisitor
		ifAbsent: [
			Smalltalk globals
				at: #CoTypingVisitor
				ifAbsent: [ nil ] ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> typeNameFor: aType [

	aType ifNil: [ ^ '' ].
	(aType respondsTo: #name) ifTrue: [
		^ [ aType name asString ] on: Error do: [ aType asString ] ].
	^ [ aType asString ] on: Error do: [ '' ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> typeNamesStringFor: typeCollection [

	| types |
	types := self normalizeSemanticTypes: typeCollection.
	^ String streamContents: [ :stream |
		types
			do: [ :type | stream nextPutAll: (self typeNameFor: type) ]
			separatedBy: [ stream nextPutAll: ', ' ] ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> typePropertyOfNode: aNode [

	aNode ifNil: [ ^ nil ].
	(aNode respondsTo: #propertyAt:ifAbsent:) ifTrue: [
		^ [ aNode propertyAt: #type ifAbsent: [ nil ] ]
			on: Error
			do: [ nil ] ].
	^ nil
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> updateContextInfo: contextInfo withClassContext: classContext [

	contextInfo
		at: #classContextLength put: classContext size;
		at: #classContextPresent put: classContext isEmpty not
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> variableBindingNamesFor: aContext [

	| names seen addName engine requestor model bindings |
	names := OrderedCollection new.
	seen := Set new.
	addName := [ :name |
		| text |
		name ifNotNil: [
			text := name asString.
			(text isEmpty or: [ seen includes: text ]) ifFalse: [
				seen add: text.
				names add: text ] ] ].

	engine := self engineFor: aContext.
	(engine notNil and: [ engine respondsTo: #variableBindingNames ]) ifTrue: [
		[ engine variableBindingNames do: addName ]
			on: Error
			do: [ ] ].

	(aContext notNil and: [ aContext respondsTo: #variableBindingNames ]) ifTrue: [
		[ aContext variableBindingNames do: addName ]
			on: Error
			do: [ ] ].

	requestor := self doItRequestorFor: aContext.
	requestor ifNotNil: [
		model := self modelForRequestor: requestor.
		bindings := (model respondsTo: #variableBindings)
			ifTrue: [ [ model variableBindings ] on: Error do: [ nil ] ]
			ifFalse: [ nil ].
		(bindings notNil and: [ bindings respondsTo: #keys ]) ifTrue: [
			bindings keys do: addName ] ].

	addName value: 'self'.
	^ names asArray
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> visibleBindingTypeDescriptionsFor: aContext limit: limitInteger [

	| descriptions limit |
	descriptions := OrderedCollection new.
	limit := limitInteger ifNil: [ 12 ].

	(self variableBindingNamesFor: aContext) do: [ :name |
		descriptions size >= limit ifTrue: [ ^ descriptions asArray ].
		self
			liveVariableValueNamed: name
			inContext: aContext
			ifPresent: [ :value |
				descriptions add: name , ' -> ' , (self typeNameFor: value class) ] ].

	^ descriptions asArray
]
