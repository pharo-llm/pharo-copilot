CoPharoCopilotResultSetBuilder >> cachedSemanticReceiverInfoForKey: key [

	(lastSemanticReceiverKey notNil and: [ lastSemanticReceiverKey = key ])
		ifTrue: [ ^ lastSemanticReceiverValue ].
	^ nil
]

