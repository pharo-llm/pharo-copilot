"
Builds completion result sets using suggestions generated by the Ollama API.

"
Class {
	#name : 'CoPharoCopilotResultSetBuilder',
	#superclass : 'CoResultSetBuilder',
	#instVars : [
		'debounceProcess',
		'debounceToken',
		'debounceMilliseconds',
		'idleMilliseconds',
		'classContextCache',
		'menuMorph',
		'completionCache',
		'cachedClient',
		'lastSnapshotKey',
		'lastSnapshotValue',
		'classContextClock',
		'classContextOldestKey',
		'classContextOldestTime',
		'lastSelectorPrefix',
		'lastSelectorResult',
		'sortedSelectorsCache',
		'lastSemanticReceiverKey',
		'lastSemanticReceiverValue',
		'completionRouter',
		'generationPolicy',
		'semanticProvider'
	],
	#category : 'AI-Pharo-Copilot',
	#package : 'AI-Pharo-Copilot'
}

{ #category : 'instance creation' }
CoPharoCopilotResultSetBuilder class >> initializeOnContext: aSystemCompletionContext [

	"Create and initialize a builder bound to the given completion context."
	^ self new
		initializeOnContext: aSystemCompletionContext;
		yourself
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> appendFallbackCompletionEntriesTo: entryCollection inContext: aContext [

	^ self
		appendFallbackCompletionEntriesTo: entryCollection
		inContext: aContext
		contextInfo: nil
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> appendFallbackCompletionEntriesTo: entryCollection inContext: aContext contextInfo: contextInfo [

	"Compatibility no-op: Copilot completions are no longer enriched with Complishon entries."
	| combined |
	combined := OrderedCollection new.
	entryCollection ifNotNil: [ combined addAll: entryCollection ].
	^ combined asArray
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> appendInteractionHistory: historyString toContext: contextString [
	"Append IDE/user interaction history as the final repo-style context section.
	The FIM tail is added later by the Ollama client, so this section lands immediately
	before <|fim_prefix|> without appearing after <|fim_middle|>."

	| history base lf |
	history := historyString ifNil: [ '' ] ifNotNil: [ historyString asString ].
	base := contextString ifNil: [ '' ] ifNotNil: [ contextString asString ].
	history isEmpty ifTrue: [ ^ base ].

	lf := Character lf.
	^ String streamContents: [ :s |
		base isEmpty ifFalse: [
			s nextPutAll: base.
			base last = lf ifFalse: [ s nextPut: lf ] ].
		s
			nextPutAll: '<|file_sep|>IDE interaction history';
			nextPut: lf;
			nextPutAll: history.
		history last = lf ifFalse: [ s nextPut: lf ] ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> appendInteractionHistoryToContext: contextString [

	CoPCContextNavigationHistory enabled ifFalse: [ ^ contextString ifNil: [ '' ] ].
	^ self
		appendInteractionHistory: self interactionHistoryForPrompt
		toContext: contextString
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> appendSemanticCompletionContextFor: aContext prefix: prefixString toContext: contextString [

	| semantic base lf |
	semantic := self semanticCompletionContextFor: aContext prefix: prefixString.
	semantic isEmpty ifTrue: [ ^ contextString ifNil: [ '' ] ].

	base := contextString ifNil: [ '' ] ifNotNil: [ contextString asString ].
	lf := Character lf.
	^ String streamContents: [ :stream |
		base isEmpty ifFalse: [
			stream nextPutAll: base.
			base last = lf ifFalse: [ stream nextPut: lf ] ].
		stream
			nextPutAll: '<|file_sep|>Semantic completion context';
			nextPut: lf;
			nextPutAll: semantic.
		semantic last = lf ifFalse: [ stream nextPut: lf ] ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> applyContent: contentString toContext: aContext expectedPrefix: expectedPrefix suffix: expectedSuffix contextInfo: contextInfo [ 

	self
		applyContents: { contentString }
		toContext: aContext
		expectedPrefix: expectedPrefix
		suffix: expectedSuffix
		contextInfo: contextInfo
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> applyContents: contentCollection toContext: aContext expectedPrefix: expectedPrefix suffix: expectedSuffix contextInfo: contextInfo [

	| adjustedContents entries position typedAhead |

	(self hasStaleContextFor: aContext expectedPrefix: expectedPrefix suffix: expectedSuffix)
		ifTrue: [ ^ self logStaleContextForExpectedPrefix: expectedPrefix suffix: expectedSuffix context: aContext ].

	typedAhead := self
		typedAheadIn: aContext
		expectedPrefix: expectedPrefix
		suffix: expectedSuffix.
	adjustedContents := self
		stripAlreadyTyped: typedAhead
		fromSuggestions: contentCollection.

	entries := self
		completionEntriesFrom: adjustedContents
		inContext: aContext
		contextInfo: contextInfo.
	entries isEmpty ifTrue: [ ^ self logNoEntriesAfterCleaningFor: adjustedContents ].

	position := self menuPositionForContextOrDefault: aContext.

	self openCompletionMenuFor: aContext entries: entries position: position
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> behaviorFor: aContext [

	| behavior engine |
	aContext ifNil: [ ^ nil ].

	behavior := (aContext respondsTo: #completionClass)
		ifTrue: [ [ aContext completionClass ] on: Error do: [ nil ] ]
		ifFalse: [ nil ].
	behavior ifNotNil: [ ^ behavior ].

	behavior := (aContext respondsTo: #behavior)
		ifTrue: [ [ aContext behavior ] on: Error do: [ nil ] ]
		ifFalse: [ nil ].
	behavior ifNotNil: [ ^ behavior ].

	engine := self engineFor: aContext.
	^ (engine notNil and: [ engine respondsTo: #completionClass ])
		ifTrue: [ [ engine completionClass ] on: Error do: [ nil ] ]
		ifFalse: [ nil ]
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> engineFor: aContext [

	aContext ifNil: [ ^ nil ].
	^ (aContext respondsTo: #engine)
		ifTrue: [ [ aContext engine ] on: Error do: [ nil ] ]
		ifFalse: [ nil ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> buildClassContextFor: methodClass selector: selector prefix: prefixString [
	"Answer the STATIC repo-level context for the class being edited — never the FIM
	tail with the user prefix. The result is cached per class, and a baked-in prefix
	would poison every later completion; the FIM tail is composed per request by the
	Ollama client. methodClass comes from the editor and is authoritative: resolving
	the class by scanning the system for the typed selector can hit an unrelated class."

	| classDefinition instanceSide classSide |
	methodClass ifNil: [ ^ '' ].

	classDefinition := self safeDefinitionStringFor: methodClass.
	instanceSide := self
		contextMethodSectionFor: methodClass
		around: selector
		limit: CopilotSettings maxInstanceMethods.
	classSide := self
		contextMethodSectionFor: methodClass class
		around: nil
		limit: CopilotSettings maxClassMethods.

	^ self
		repoContextForClass: methodClass
		definition: classDefinition
		instanceMethods: instanceSide
		classMethods: classSide
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> buildCompletion [

	| context snapshot prefix suffix contextInfo delay cached |
	context := completionContext.

	(self shouldRequestCompletionForContext: context) ifFalse: [ ^ self emptyResultSet ].

	snapshot := self contextSnapshotFor: context.
	prefix := snapshot at: #prefix.
	suffix := snapshot at: #suffix.
	contextInfo := self contextInfoFor: context prefix: prefix suffix: suffix.

	self isLoggingEnabled ifTrue: [
	contextInfo
		at: #sessionId put: CoPharoCopilotLogger completionSessionId;
		at: #timestamp put: DateAndTime now asString;
		at: #rejected put: OrderedCollection new].

	cached := self
		fastCachedSuggestionsFor: context
		prefix: prefix
		suffix: suffix
		contextInfo: contextInfo.
	cached ifNotNil: [
		(self openCachedSuggestions: cached for: context prefix: prefix suffix: suffix contextInfo: contextInfo)
			ifTrue: [ ^ self emptyResultSet ] ].
	
	delay := self requestDelayForSnapshot: snapshot.

	self
		scheduleCompletionFor: context
		prefix: prefix
		suffix: suffix
		contextInfo: contextInfo
		delayMilliseconds: delay.

	^ self emptyResultSet
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> cacheClassContext: contextString for: methodClass [

	| tick |
	methodClass ifNil: [ ^ self ].
	self ensureClassContextCacheCapacity.
	tick := self classContextTick.
	classContextCache at: methodClass put: (Dictionary new
			 at: #stamp put: (self classStampFor: methodClass);
			 at: #context put: contextString;
			 at: #accessTime put: tick;
			 yourself).
	(classContextOldestKey isNil or: [ classContextOldestTime isNil ]) ifFalse: [ ^ self ].
	classContextOldestKey := methodClass.
	classContextOldestTime := tick
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> cacheSuggestions: suggestions prefix: prefixString suffix: suffixString classContext: classContext [

	suggestions isEmpty ifTrue: [ ^ self ].

	self completionCache
		at: prefixString
		suffix: suffixString
		context: classContext
		put: suggestions asArray
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> cacheFastSuggestions: suggestions for: aContext prefix: prefixString suffix: suffixString [

	suggestions isEmpty ifTrue: [ ^ self ].

	self completionCache
		at: prefixString
		suffix: suffixString
		context: (self fastCacheContextFor: aContext prefix: prefixString)
		put: suggestions asArray
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> cachedClassContextFor: methodClass [

	| cached stamp |
	classContextCache ifNil: [ classContextCache := Dictionary new ].

	stamp := self classStampFor: methodClass.
	cached := classContextCache at: methodClass ifAbsent: [ nil ].

	(cached notNil and: [ (cached at: #stamp ifAbsent: [ #(0 0) ]) = stamp ]) ifFalse: [
		^ nil
	].

	cached at: #accessTime put: self classContextTick.
	^ cached at: #context ifAbsent: [ '' ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> cachedSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext contextInfo: contextInfo [

	| cachedContent |
	cachedContent := self exactCachedSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext.

	cachedContent ifNil: [
		cachedContent := self nearMatchCachedSuggestionsForPrefix: prefixString suffix: suffixString classContext: classContext
	].

	contextInfo at: #cacheHit put: cachedContent notNil.
	^ cachedContent
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> classContextFor: aContext [

	| snapshot prefix |
	aContext ifNil: [ ^ '' ].
	snapshot := self contextSnapshotFor: aContext.
	prefix := snapshot at: #prefix ifAbsent: [ '' ].
	^ self classContextFor: aContext prefix: prefix
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> classContextFor: aContext prefix: prefixString [

	| behavior selector methodClass cachedContext builtContext classContext |
	behavior := self behaviorFor: aContext.
	classContext := ''.

	behavior ifNotNil: [
		selector := self selectorFromPrefix: prefixString.
		methodClass := self methodClassForBehavior: behavior selector: selector.

		cachedContext := self cachedClassContextFor: methodClass.
		classContext := cachedContext
			ifNotNil: [ cachedContext ]
			ifNil: [
				builtContext := self buildClassContextFor: methodClass selector: selector prefix: prefixString.
				self cacheClassContext: builtContext for: methodClass.
				builtContext ] ].

	classContext := self
		appendSemanticCompletionContextFor: aContext
		prefix: prefixString
		toContext: classContext.

	"Comment the next line to disconnect IDE interaction history from the model context."
	^ self appendInteractionHistoryToContext: classContext
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> classContextTick [

	classContextClock ifNil: [ classContextClock := 0 ].
	classContextClock := classContextClock + 1.
	^ classContextClock
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> classDefinition: classDefinitionString instanceMethods: instanceMethodsString classMethods: classMethodsString [
	"Format the class context (definition and methods) into a single string suitable for passing to the model."

	| hasDefinition hasInstance hasClass |
	hasDefinition := classDefinitionString isEmpty not.
	hasInstance := instanceMethodsString isEmpty not.
	hasClass := classMethodsString isEmpty not.

	(hasDefinition or: [ hasInstance or: hasClass ]) ifFalse: [ ^ '' ].

	^ String streamContents: [ :stream |
		hasDefinition ifTrue: [
			stream
				nextPutAll: 'Class Definition:';
				cr;
				nextPutAll: classDefinitionString;
				cr;
				cr ].

		hasInstance ifTrue: [
			stream
				nextPutAll: 'Instance Side Methods:';
				cr;
				nextPutAll: instanceMethodsString;
				cr ].

		hasClass ifTrue: [
			stream
				nextPutAll: 'Class Side Methods:';
				cr;
				nextPutAll: classMethodsString ] ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> classStampFor: aBehavior [

	"Cheap stamp: changes when methodDict is replaced or method count changes.
	Uses methodDict size (O(1)) instead of selectors size (which builds a fresh Array)."
	| dict |
	aBehavior ifNil: [ ^ #(0 0) ].
	dict := aBehavior methodDict.
	^ { dict identityHash. dict size }
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> cleanedContentFrom: aString [
	"Normalize suggestion text: prefer code-fence body if present, drop language markers, trim surrounding whitespace."

	| text fenceStart rest fenceEnd body newlineIndex firstLine delimiterIndex |
	text := (aString ifNil: [ '' ]) asString.
	text isEmpty ifTrue: [ ^ '' ].

	fenceStart := text indexOfSubCollection: '```' startingAt: 1 ifAbsent: [ 0 ].
	fenceStart > 0 ifTrue: [
		rest := (fenceStart + 3 <= text size)
			ifTrue: [ text copyFrom: fenceStart + 3 to: text size ]
			ifFalse: [ '' ].

		fenceEnd := self indexOfClosingFenceIn: rest startingAt: 1.
		fenceEnd := fenceEnd = 0
			ifTrue: [ rest size + 1 ]
			ifFalse: [ fenceEnd ].

		body := fenceEnd <= 1
			ifTrue: [ '' ]
			ifFalse: [ rest copyFrom: 1 to: fenceEnd - 1 ].

		"Drop a first-line language spec like ```smalltalk"
		newlineIndex := body indexOf: Character lf ifAbsent: [ 0 ].
		newlineIndex > 0 ifTrue: [
			firstLine := body copyFrom: 1 to: newlineIndex - 1.
			((firstLine isEmpty) or: [ self isLanguageSpec: firstLine ]) ifTrue: [
				body := newlineIndex < body size
					ifTrue: [ body copyFrom: newlineIndex + 1 to: body size ]
					ifFalse: [ '' ] ] ]
		ifFalse: [
			(self isLanguageSpec: body) ifTrue: [ body := '' ] ].

		^ body trimBoth 
	].

	"Fallback: keep only the first paragraph if multiple paragraphs exist."
	delimiterIndex := text indexOfSubCollection: (String lf , String lf) startingAt: 1 ifAbsent: [ 0 ].
	body := delimiterIndex = 0
		ifTrue: [ text ]
		ifFalse: [ text copyFrom: 1 to: delimiterIndex - 1 ].

	^ body trimBoth
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> closeMenu [
	"Close the menu if it's open."

	menuMorph ifNotNil: [
		menuMorph isClosed ifFalse: [ menuMorph delete ].
		menuMorph := nil
	]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> collectNormalizedSuggestionsFor: client prefix: prefixString suffix: suffixString context: classContext contextInfo: contextInfo [

	^ self
		collectNormalizedSuggestionsFor: client
		prefix: prefixString
		suffix: suffixString
		context: classContext
		contextInfo: contextInfo
		requestOptions: nil
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> collectNormalizedSuggestionsFor: client prefix: prefixString suffix: suffixString context: classContext contextInfo: contextInfo requestOptions: requestOptions [

	| desiredCount collected seen |
	desiredCount := CopilotSettings completionSuggestionsCount.
	collected := OrderedCollection new.
	seen := Set new.

	1 to: desiredCount do: [ :attempt |
		| content |
		collected size >= desiredCount ifTrue: [ ^ self finalizeCollectedSuggestions: collected contextInfo: contextInfo ].

		content := self
			normalizedSuggestionFrom: client
			prefix: prefixString
			suffix: suffixString
			context: classContext
			attempt: attempt
			contextInfo: contextInfo
			requestOptions: requestOptions.

		(content isEmpty not and: [ (seen includes: content) not ]) ifTrue: [
			seen add: content.
			collected add: content
		]
	].

	^ self finalizeCollectedSuggestions: collected contextInfo: contextInfo
]

{ #category : 'routing' }
CoPharoCopilotResultSetBuilder >> completionRouter [

	^ completionRouter ifNil: [
		completionRouter := CoPCCompletionRouter new ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> completionCache [
	"Return the completion cache, creating it lazily."

	^ completionCache ifNil: [ completionCache := CoPharoCopilotCompletionCache new ]
]

{ #category : 'initialization' }
CoPharoCopilotResultSetBuilder >> completionCache: aCache [

	completionCache := aCache
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> completionEntriesFrom: contentCollection inContext: aContext [

	| cleaned fakeContextInfo copilotEntries |

	fakeContextInfo := Dictionary new
		at: #prefix put: (aContext
			ifNil: [ '' ]
			ifNotNil: [ (self contextSnapshotFor: aContext) at: #prefix ifAbsent: [ '' ] ]);
		yourself.
	cleaned := self
		normalizedCompletionContentsFrom: contentCollection
		inContext: aContext
		contextInfo: fakeContextInfo.

	copilotEntries := cleaned collect: [ :each |
		| entry |
		entry := CoCopilotEntry
			contents: each
			description: (self descriptionForSuggestion: each inContext: aContext).
		entry label: (self menuLabelForSuggestion: each contextInfo: fakeContextInfo).
		entry ].

	^ copilotEntries asArray
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> completionEntriesFrom: contentCollection inContext: aContext contextInfo: contextInfo [

	| cleaned sessionId copilotEntries |
	cleaned := self
		normalizedCompletionContentsFrom: contentCollection
		inContext: aContext
		contextInfo: contextInfo.

	sessionId := contextInfo at: #sessionId ifAbsent: [ nil ].

	copilotEntries := cleaned collect: [ :each |
		| entry |
		entry := CoCopilotEntry
			contents: each
			description: (self descriptionForSuggestion: each inContext: aContext).

		entry label: (self menuLabelForSuggestion: each contextInfo: contextInfo).

		(entry respondsTo: #sessionId:) ifTrue: [
			entry sessionId: sessionId ].

		entry ].

	^ copilotEntries asArray
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> completionPrefixFor: aContext contextInfo: contextInfo [

	contextInfo ifNotNil: [
		^ contextInfo
			at: #prefix
			ifAbsent: [
				aContext
					ifNil: [ '' ]
					ifNotNil: [ (self contextSnapshotFor: aContext) at: #prefix ifAbsent: [ '' ] ] ] ].

	^ aContext
		ifNil: [ '' ]
		ifNotNil: [ (self contextSnapshotFor: aContext) at: #prefix ifAbsent: [ '' ] ]
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> completionKindFor: aContext prefix: prefixString [

	| source position |
	source := [ aContext source ifNil: [ prefixString ifNil: [ '' ] ] ]
		on: Error
		do: [ prefixString ifNil: [ '' ] ].
	position := [ aContext position ifNil: [ source size ] ]
		on: Error
		do: [ source size ].
	position := (position max: 0) min: source size.

	^ self
		completionKindForSource: source
		position: position
		prefix: prefixString
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> completionKindForSource: sourceString position: positionInteger prefix: prefixString [

	| prefix token receiver last |
	prefix := prefixString
		ifNil: [
			positionInteger <= 0
				ifTrue: [ '' ]
				ifFalse: [ sourceString copyFrom: 1 to: positionInteger ] ]
		ifNotNil: [ prefixString asString ].
	prefix := prefix ifNil: [ '' ].

	token := self trailingWordFragmentIn: prefix.
	receiver := self textualReceiverBeforeCompletionIn: prefix.
	(token isEmpty not and: [
		receiver isEmpty not and: [ receiver ~= token ] ])
			ifTrue: [ ^ #messageTail ].

	last := self lastNonSeparatorCharacterIn: prefix.
	last ifNil: [ ^ #statement ].
	last = $^ ifTrue: [ ^ #returnExpression ].
	((prefix trimRight) endsWith: ':=') ifTrue: [ ^ #assignmentRHS ].
	last = $[ ifTrue: [ ^ #blockBody ].
	last = $. ifTrue: [ ^ #statement ].

	^ #expression
]

{ #category : 'semantic context' }
CoPharoCopilotResultSetBuilder >> commaSeparatedStrings: aCollection [

	^ String streamContents: [ :stream |
		aCollection
			do: [ :each | stream nextPutAll: each asString ]
			separatedBy: [ stream nextPutAll: ', ' ] ]
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> computeAndCacheSelectorFromPrefix: prefixString header: header [

	| extractor ast result |
	extractor := CNSelectorExtractor new.
	ast := OCParser parseFaultyMethod: prefixString.
	result := extractor extractSelectorFromAST: ast atPosition: 1.

	lastSelectorPrefix := header.
	lastSelectorResult := result.
	^ result
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> contextInfoFor: aContext prefix: prefixString suffix: suffixString [

	| info |
	info := Dictionary new
		at: #prefix put: prefixString;
		at: #suffix put: suffixString;
		yourself.
	self isLoggingEnabled ifTrue: [
		info
			at: #contextClass put: aContext class name;
			at: #cursorPosition put: aContext position;
			at: #sourceSize put: aContext source size;
			at: #fullSource put: aContext source;
			at: #completionEnvironment put: (self completionEnvironmentFor: aContext) ].
	^ info
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> completionEnvironmentFor: aContext [

	| engine editor morph window ownerClasses title isScripting kind requestor requestorModel |
	engine := self engineFor: aContext.
	requestor := self doItRequestorFor: aContext.
	requestorModel := self modelForRequestor: requestor.
	editor := self liveEditorFor: aContext.
	morph := self morphForEditor: editor.
	morph ifNil: [ morph := self morphForRequestor: requestor ].
	window := self windowForMorph: morph.
	ownerClasses := self ownerClassNamesForMorph: morph limit: 12.
	title := self titleForWindow: window.
	isScripting := self isScriptingContext: aContext.
	kind := self
		completionEnvironmentKindForContext: aContext
		engine: engine
		editor: editor
		morph: morph
		window: window
		ownerClasses: ownerClasses
		windowTitle: title
		isScripting: isScripting
		requestor: requestor.

	^ Dictionary new
		at: #kind put: kind;
		at: #isScripting put: isScripting;
		at: #contextClass put: (self telemetryClassNameFor: aContext);
		at: #engineClass put: (self telemetryClassNameFor: engine);
		at: #requestorClass put: (self telemetryClassNameFor: requestor);
		at: #requestorModelClass put: (self telemetryClassNameFor: requestorModel);
		at: #editorClass put: (self telemetryClassNameFor: editor);
		at: #morphClass put: (self telemetryClassNameFor: morph);
		at: #windowClass put: (self telemetryClassNameFor: window);
		at: #windowTitle put: title;
		at: #ownerClasses put: ownerClasses asArray;
		yourself
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> completionEnvironmentKindForContext: aContext engine: engine editor: editor morph: morph window: window ownerClasses: ownerClasses windowTitle: title isScripting: isScripting requestor: requestor [

	| text requestorModel |
	requestorModel := self modelForRequestor: requestor.
	text := String streamContents: [ :stream |
		{ aContext. engine. requestor. requestorModel. editor. morph. window } do: [ :each |
			each ifNotNil: [
				stream
					nextPutAll: each class name asString;
					space ] ].
		ownerClasses do: [ :each |
			stream
				nextPutAll: each asString;
				space ].
		stream nextPutAll: title asString ].
	text := text asLowercase.

	(text includesSubstring: 'inspector') ifTrue: [ ^ #inspector ].
	((text includesSubstring: 'debugger') or: [
		(text includesSubstring: 'testfailure') or: [
		text includesSubstring: 'testerror' ] ])
			ifTrue: [ ^ #debugger ].
	((text includesSubstring: 'playground') or: [ text includesSubstring: 'workspace' ])
		ifTrue: [ ^ #playground ].
	((text includesSubstring: 'browser') or: [
		(text includesSubstring: 'calypso') or: [ text includesSubstring: 'cly' ] ])
		ifTrue: [ ^ #systemBrowser ].
	isScripting ifTrue: [ ^ #scripting ].
	^ #unknown
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> morphForEditor: editor [

	^ self
		morphFrom: editor
		selectors: #(morph textArea widget view)
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> morphForRequestor: requestor [

	| morph model |
	morph := self
		morphFrom: requestor
		selectors: #(morph window widget view).
	morph ifNotNil: [ ^ morph ].

	model := self modelForRequestor: requestor.
	^ self
		morphFrom: model
		selectors: #(morph window widget view)
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> morphFrom: anObject selectors: selectorCollection [

	| candidate |
	anObject ifNil: [ ^ nil ].
	selectorCollection do: [ :selector |
		(anObject respondsTo: selector) ifTrue: [
			candidate := [ anObject perform: selector ] on: Error do: [ nil ].
			candidate ifNotNil: [ ^ candidate ] ] ].
	^ nil
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> ownerClassNamesForMorph: morph limit: limitInteger [

	| classes current limit |
	classes := OrderedCollection new.
	current := morph.
	limit := limitInteger ifNil: [ 12 ].
	[ current notNil and: [ classes size < limit ] ] whileTrue: [
		classes add: (self telemetryClassNameFor: current).
		current := (current respondsTo: #owner)
			ifTrue: [ [ current owner ] on: Error do: [ nil ] ]
			ifFalse: [ nil ] ].
	^ classes asArray
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> telemetryClassNameFor: anObject [

	anObject ifNil: [ ^ '' ].
	^ [ anObject class name asString ] on: Error do: [ '' ]
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> telemetryStringFor: anObject max: maxLength [

	| text limit |
	anObject ifNil: [ ^ '' ].
	text := [ anObject asString ] on: Error do: [ '' ].
	text ifNil: [ ^ '' ].
	limit := maxLength ifNil: [ 120 ].
	^ text size > limit
		ifTrue: [ text copyFrom: 1 to: limit ]
		ifFalse: [ text ]
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> titleForWindow: window [

	#(label labelString title titleString name) do: [ :selector |
		(window notNil and: [ window respondsTo: selector ]) ifTrue: [
			| value title |
			value := [ window perform: selector ] on: Error do: [ nil ].
			title := self telemetryStringFor: value max: 120.
			title isEmpty ifFalse: [ ^ title ] ] ].
	^ ''
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> windowForMorph: morph [

	morph ifNil: [ ^ nil ].
	(morph respondsTo: #window) ifTrue: [
		| window |
		window := [ morph window ] on: Error do: [ nil ].
		window ifNotNil: [ ^ window ] ].
	^ self windowInOwnerChainForMorph: morph
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> windowInOwnerChainForMorph: morph [

	| current |
	current := morph.
	[ current notNil ] whileTrue: [
		((self telemetryClassNameFor: current) asLowercase includesSubstring: 'window')
			ifTrue: [ ^ current ].
		current := (current respondsTo: #owner)
			ifTrue: [ [ current owner ] on: Error do: [ nil ] ]
			ifFalse: [ nil ] ].
	^ nil
]

{ #category : 'new' }
CoPharoCopilotResultSetBuilder >> contextMethodSectionFor: aBehavior around: aSelector limit: limitInteger [
	"Render the methods section honoring the configured context mode: full sources
	(windowed around the current selector) or a lightweight selectors-only overview."

	aBehavior ifNil: [ ^ '' ].

	CoPCContextSettings mode = #selectors ifTrue: [
		^ String streamContents: [ :s |
			(self sortedSelectorsFor: aBehavior)
				do: [ :sel | s nextPutAll: sel asString ]
				separatedBy: [ s nextPut: Character lf ] ] ].

	^ self methodSourcesFor: aBehavior around: aSelector limit: limitInteger
]

{ #category : 'private' }
CoPharoCopilotResultSetBuilder >> contextSnapshotFor: aContext [

	| source position prefix suffix |
	source := [ aContext source ifNil: [ '' ] ]
		          on: Error
		          do: [ '' ].
	position := [ aContext position ifNil: [ 0 ] ]
		            on: Error
		            do: [ 0 ].
	position := (position max: 0) min: source size.

	  (lastSnapshotKey notNil
        and: [ lastSnapshotKey first == source
        and: [ lastSnapshotKey second = position ] ])
            ifTrue: [ ^ lastSnapshotValue ].

	prefix := position > 0
		          ifTrue: [ source copyFrom: 1 to: position ]
		          ifFalse: [ '' ].
	suffix := position < source size
		          ifTrue: [ source copyFrom: position + 1 to: source size ]
		          ifFalse: [ '' ].

lastSnapshotKey := { source. position }.
	lastSnapshotValue := Dictionary new
		                     at: #prefix put: prefix;
		                     at: #suffix put: suffix;
		                     at: #position put: position;
		                     at: #sourceLength put: source size;
		                     yourself.

	^ lastSnapshotValue
]

